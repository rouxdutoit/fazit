    summary > .icon { transition: transform 0.3s var(--ease); }
    details[open] > summary > .icon { transform: rotate(90deg); }
    .evidence-counts { color: var(--fg-2); }
    .cost-inputs, .licence-products { margin-block-start: 32px; }
    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 24px;
      margin: 24px 0 8px;
      padding: 0;
      color: var(--fg-2);
      font-size: var(--fs-subhead);
      list-style: none;
    }
    .cost-swatch {
      --symbol-size: var(--cap-height);
      border-radius: var(--radius-pill);
      background: var(--cost-fill);
    }
    @media screen {
      .cost-swatch { outline: 1px solid var(--fg-2); }
    }
    .cost-chart-row { margin-top: 24px; }
    .cost-chart-heading {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 4px 16px;
    }
    .cost-chart-heading h3, .cost-chart-heading > p { margin: 0; }
    .cost-chart-heading > p { text-align: end; }
    .cost-bar {
      display: flex;
      width: calc(var(--share) * (100% - 56px));
      height: 24px;
      gap: 2px;
      margin-top: 8px;
      overflow: hidden;
      border-radius: var(--radius-pill);
    }
    @media screen {
      .cost-bar:has(.cost-segment) { outline: 1px solid var(--fg-2); }
    }
    .cost-segment { min-width: 2px; background: var(--cost-fill); }
    .cost-running { --cost-fill: var(--fg); }
    .cost-direct_project { --cost-fill: var(--fg-2); }
    .cost-productivity_loss { --cost-fill: color-mix(in srgb, var(--fg-2) 55%, var(--bg)); }
    .cost-parallel_running { --cost-fill: color-mix(in srgb, var(--fg-2) 25%, var(--bg)); }
    .cost-segment.is-unknown {
      justify-content: center;
      width: 48px;
      height: 24px;
      margin-top: 8px;
      border: 1px dashed var(--fg-2);
      border-radius: var(--radius-pill);
      background: transparent;
      color: var(--fg-2);
    }
    .cost-known-blocks { margin-top: 8px; }
    .cost-chart-values {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 24px;
      margin: 8px 0 0;
      padding: 0;
      color: var(--fg-2);
      font-size: var(--fs-subhead);
      list-style: none;
    }
    .cost-chart-values li:has(.cost-value) {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px;
    }
    .cost-table thead th:first-child { width: 34%; }
    .cost-table thead th:not(:first-child), .cost-table td { text-align: end; }
    .cost-table td, .cost-value { font-variant-numeric: tabular-nums; }
    .cost-table .totals { background: var(--fill); }
    .cost-table :is(.subtotals, .totals) td { font-weight: 600; }
    .cost-table th:first-child { padding-inline-start: 16px; }
    :is(.run-details, .rule-details, .mapping-details) { margin-block: 16px; }
    :is(.run-details, .rule-details, .mapping-details) dt { font-weight: 600; }
    :is(.run-details, .rule-details, .mapping-details) dd { margin: 4px 0 12px; }
    .mapping-details dd > :first-child { text-wrap: balance; }
    .condition-value { white-space: nowrap; }
    [data-section=appendix] ul { margin-block: 8px; padding-inline-start: 16px; }
    [data-checksum] { display: block; font-size: var(--fs-subhead); }
    footer {
      width: calc(100% - 2 * var(--gutter));
      max-width: calc(var(--max) - 2 * var(--gutter));
      margin-inline: auto;
      margin-block-start: 32px;
      padding-block: 16px 48px;
      border-block-start: 1px solid var(--line);
      color: var(--muted);
      font-size: var(--fs-footnote);
    }
    @media (prefers-reduced-motion: reduce) {
      a, summary > .icon, .segmented label { transition: none; }
    }
    @media screen and (max-width: 600px) {
      .replacements tbody th { text-wrap: balance; }
      .coverage thead {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
      }
      .coverage tr {
        display: grid;
        gap: 8px;
        padding-block: 16px;
        border-bottom: 1px solid var(--rule);
      }
      .coverage tbody tr:last-child { border-bottom: 0; }
      .coverage th, .coverage td {
        padding: 0;
        border-bottom: 0;
      }
      .coverage tbody th {
        width: auto;
      }
      .coverage td::before {
        display: block;
        margin-bottom: 2px;
        color: var(--fg-2);
        font-size: var(--fs-footnote);
        font-weight: 600;
        content: attr(data-label);
      }
      :is(.file-types, .software-table) tr {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: 16px;
      }
      :is(.file-types, .software-table) tbody th, .file-types tbody td:last-child {
        grid-column: 1 / -1;
      }
    }
    @media screen and (width < 70rem) {
      .replacements thead {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
      }
      .replacements tbody tr {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px 16px;
        padding-block: 24px;
        border-block-end: 1px solid var(--rule);
      }
      .replacements tbody tr:last-child { border-block-end: 0; }
      .replacements tbody :is(th, td) {
        width: auto;
        margin: 0;
        padding: 0;
        border: 0;
      }
      .replacements tbody th { font-size: var(--fs-body); }
      .replacements tbody :is(th, td:nth-child(2), td:nth-child(3)) { grid-column: 1 / -1; }
      .replacements:has(.checked-on) tbody td:nth-child(3) { grid-column: auto; }
      .replacements td::before, .replacement-name::before {
        display: block;
        margin-block-end: 4px;
        color: var(--fg-2);
        font-size: var(--fs-footnote);
        font-weight: 600;
        content: attr(data-label);
      }
      .replacements td[data-coverage-label]::before { content: attr(data-coverage-label); }
      .replacement-name { margin-block-start: 12px; padding: 0; }
    }
    @media screen and (640px <= width < 70rem) {
      .replacements:not(:has(.checked-on)) tbody tr { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .replacements tbody td:nth-child(3) { grid-column: auto; }
    }
    @media screen and (width < 22.5rem) {
      .replacements tbody tr { grid-template-columns: minmax(0, 1fr); }
    }
    @media screen and (max-width: 40rem) {
      .segmented { border-radius: var(--radius-card); }
      .segmented label { flex: 1 1 auto; padding-inline: 4px; }
      .cost-table thead {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      .cost-chart-values { display: grid; }
      .cost-chart-heading { display: grid; justify-content: start; }
      .cost-chart-heading > p { text-align: start; }
      .cost-table, .cost-table :is(caption, tbody) { display: block; }
      .cost-table tr {
        display: grid;
        gap: 4px;
        padding: 16px;
        border-bottom: 1px solid var(--rule);
      }
      .cost-table :is(th, td), .cost-table th:first-child { padding: 0; border-bottom: 0; }
      .cost-table tbody th { margin-bottom: 8px; }
      .cost-table td {
        display: grid;
        grid-template-columns: minmax(0, 1fr) fit-content(60%);
        align-items: baseline;
        gap: 8px;
        text-align: end;
      }
      .cost-table td::before {
        content: attr(data-label);
        color: var(--fg-2);
        font-weight: 600;
        text-align: start;
        white-space: normal;
      }
    }
    @page { margin: 15mm; }
    @media print {
      :root {
        color-scheme: light;
        --fs-title: 18pt;
        --fs-headline: 14pt;
        --fs-lead: 12pt;
        --fs-body: 10pt;
        --fs-subhead: 9pt;
        --fs-footnote: 8pt;
      }
      .bar, .skip, .filters, .areas-empty { display: none; }
      body {
        display: block;
        print-color-adjust: exact;
      }
      .page-intro, .sec { padding: 16pt 0; }
      .page-intro { padding-block: 0 4pt; }
      .page-intro h1 { font-size: var(--fs-title); }
      .grid { display: block; padding-inline: 0; }
      .sec::before { inset-inline: 0; }
      .report-meta { gap: 4pt 12pt; margin-top: 8pt; }
      .page-intro .note { margin-top: 4pt; padding: 4pt 12pt; }
      .sec-label { margin-bottom: 8pt; }
      [data-section=path], [data-section=costs], [data-section=appendix] { break-before: page; }
      h1, h2, h3, h4 { break-after: avoid; }
      .sec-body h3 { margin-block: 16pt 4pt; }
      header, [data-section=summary] { line-height: 1.15; }
      .status-summary {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 4pt 12pt;
        margin-top: 4pt;
      }
      .status-summary > div { gap: 0; }
      .status-summary > div + div { margin-top: 0; }
      [data-section=summary] .sec { padding-block: 4pt 0; }
      [data-section=summary] .sec-label { margin-bottom: 4pt; }
      [data-summary=scope] {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
        column-gap: 12pt;
      }
      [data-summary=scope] > :is(h3, p) { grid-column: 1 / -1; }
      .coverage-summary { margin-top: 4pt; }
      .coverage-summary > div + div { margin: 0; }
      .coverage-summary, .scope-requirements { font-size: var(--fs-subhead); }
      .scope-requirements { margin-top: 4pt; }
      .scope-needed { margin-block: 0 2pt; }
      .scope-links { gap: 2pt; margin: 0; }
      .summary-costs .cost-origin { margin: 0 0 4pt; }
      [data-section=summary] .subsection { margin-top: 4pt; }
      [data-section=summary] .subsection h3 { margin-block: 0 4pt; }
      [data-section=summary] .subsection > p,
      [data-section=summary] .rows { margin-top: 4pt; }
      [data-section=summary] .rows > div {
        gap: 2pt;
        padding-block: 2pt;
      }
      .rows { padding: 4pt 12pt; }
      .rows .finding-head {
        align-items: baseline;
        gap: 4pt 8pt;
      }
      .rows .finding-area { font-size: var(--fs-body); }
      .rows .finding-category { display: inline; margin-inline-start: 4pt; }
      .rows .badge { padding: 0 4pt; }
      :is(.more, .replacement-status) > .chevron { display: none; }
      .finding-head, .finding-reason, .finding-next {
        break-inside: avoid;
        break-after: avoid;
      }
      [data-section=summary] .cost-notes { gap: 0; margin-top: 4pt; }
      .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 8pt; }
      .tiles li, .finding { padding: 12pt; }
      .tiles-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8pt; }
      .tiles-3 li { gap: 2pt; padding-block: 8pt; }
      .sec-body .tiles-3 p { line-height: 1.2; }
      .tiles-3 .tile-title, .tiles-3 .tile-label { margin-bottom: 0; }
      .sec-body .tiles-3 p + p { margin-top: 0; }
      a, a:hover, .more, .more:hover { color: var(--fg); text-shadow: none; }
      footer { width: 100%; padding-block-end: 0; }
      thead { display: table-header-group; break-after: avoid; }
      .coverage th, .coverage td, .cost-table th, .cost-table td {
        padding: 4pt 8pt 4pt 0;
        border-bottom-width: 0.5pt;
      }
      tr, .tiles li, .rows > div, .mapping-gaps li,
      .rule-evidence li, .cost-chart-row { break-inside: avoid; }
      .finding, .tiles li, .rows, .note, .cost-bar .cost-segment {
        border: 0.5pt solid var(--rule);
      }
      .rows > div + div, .mapping-gaps > li + li { border-top-width: 0.5pt; }
      .cost-segment.is-unknown { border-width: 0.5pt; }
      tr:has(> th[scope="rowgroup"]) { break-after: avoid; }
      summary { min-height: 0; padding-block: 8pt; break-after: avoid; }
      summary > .icon { display: none; }
      details::details-content {
        content-visibility: visible;
        display: block;
        block-size: auto;
      }
    }
  </style>
</head>
<body>
  <a class="skip" href="#main">{{ strings.nav.skip }}</a>
  <div class="bar">
    <div class="bar-in">
      <a class="wordmark" href="#main">{{ project_name }}</a>
      {{ bar_links() }}
      <details class="bar-menu">
        <summary class="symbol-label">{{ icon('chevron-right') }}<span class="symbol-text">{{ strings.nav.on_this_page }}</span></summary>
        {{ bar_links() }}
      </details>
    </div>
  </div>
  <main id="main" tabindex="-1">
  <header data-section="header">
    <div class="page-intro">
      <p class="eyebrow">{{ inputs.organisation_name if inputs and inputs.organisation_name else strings.header.unnamed_organisation }}</p>
      <h1>{{ strings.header.title }}</h1>
      <dl class="report-meta">
        <div data-input-role="scan">
          <dt>{{ strings.header.scan_date }}</dt>
          <dd><time datetime="{{ scan.generated_at }}">{{ format.date(scan.generated_at) }}</time></dd>
        </div>
        <div data-input-role="inputs">
          <dt>{{ strings.header.inputs_date }}</dt>
          <dd>{% if inputs and inputs.as_of %}<time datetime="{{ inputs.as_of }}">{{ format.date(inputs.as_of) }}</time>
            {%- elif inputs %}{{ strings.common.date_not_supplied }}
            {%- else %}{{ strings.costs.not_provided }}{% endif %}</dd>
        </div>
        <div><dt>{{ strings.header.tool_version }}</dt><dd>{{ tool_version }}</dd></div>
        <div><dt>{{ strings.header.target_profile }}</dt><dd>{{ mapping.label[lang] }}</dd></div>
      </dl>
      {% if sample_scan %}<p class="note">{{ strings.header.sample }}</p>{% endif %}
    </div>
  </header>
    <section data-section="summary">
      <div class="sec grid">
        <h2 class="sec-label" id="summary-title">{{ strings.summary.title }}</h2>
        <div class="sec-body">
          <p class="sec-intro">{{ strings.summary.of_areas.format(n=format.integer(area_count)) }}</p>
          <dl class="status-summary">
            {% for status, count in status_counts %}
              <div>
                <dt class="status {{ status }} symbol-label">{{ status_contents(status) }} <span class="row-count symbol-text">{{ format.integer(count) }}</span></dt>
                <dd>{{ strings.summary.define[status] }}</dd>
              </div>
            {% endfor %}
          </dl>
          <div class="subsection" data-summary="blockers">
            <h3>{{ strings.summary.blockers }}</h3>
            {% if blockers %}
              {% set shown = blockers[:3] %}
              {% if blockers|length > shown|length %}
                <p class="note-text">{{ strings.summary.confirmed.format(shown=format.integer(shown|length), total=format.integer(blockers|length)) }}</p>
              {% endif %}
              <dl class="rows">
                {% for row in shown %}
                  <div>
                    {{ summary_area(row) }}
                    <dd>{{ status_reason(row) }}</dd>
                  </div>
                {% endfor %}
              </dl>
              <p class="summary-links"><a class="more symbol-label" href="#status-blocker"><span class="symbol-text">{{ strings.summary.all_blockers }}</span>{{ icon('chevron-right') }}</a></p>
            {% else %}
              <p>{{ strings.path.empty.blocker }}</p>
              {% if open_areas %}
                {% set caveat = strings.summary.caveat_one if open_areas|length == 1 else strings.summary.caveat %}
                <p class="note-text">{{ caveat.format(n=format.integer(open_areas|length)) }}</p>
              {% endif %}
            {% endif %}
          </div>
          <div class="subsection" data-summary="unknown">
            <h3>{{ strings.summary.unknown }}</h3>
            {% if open_areas %}
              <dl class="rows">
                {% for item in open_areas[:4] %}
                  <div>
                    {{ summary_area(status_by_workload[item.workload]) }}
                    <dd>
                      {% if item.finding_id %}
                        {% set question = strings.path.questions.get(item.finding_id) %}
                        {{ question or finding_labels[item.finding_id] }}{% if not question and item.fix %} ·{% endif %}
                      {% endif %}
                      {% if item.fix %}{{ item.fix }}{% endif %}
                    </dd>
                  </div>
                {% endfor %}
              </dl>
            {% else %}
              <p>{{ strings.path.empty.unknown }}</p>
            {% endif %}
            <p class="summary-links">
              <a class="more symbol-label symbol-wrap" href="#not-examined"><span class="symbol-text">{{ strings.summary.not_examined }}</span>{{ icon('chevron-right') }}</a>
              {% if missing_cost_paths %}{{ missing_cost_link(missing_cost_paths|length) }}{% endif %}
            </p>
            {% if missing_cost_paths %}<p class="note-text">{{ costs.missing_fix }}</p>{% endif %}
          </div>
          {% if scope_statement %}
            {% set scope = scope_statement %}
            <div class="subsection" data-summary="scope">
              <h3>{{ strings.summary.scope_title.format(profile=scope.profile) }}</h3>
              <p>{{ strings.summary.scope_of.format(n=format.integer(scope.total), profile=scope.profile) }}</p>
              <dl class="coverage-summary">
                {% for coverage, count in scope.by_coverage %}
                  <div>
                    <dt>{{ strings.mapping_coverage[coverage] }}</dt>
                    <dd class="row-count">{{ format.integer(count) }}</dd>
                  </div>
                {% endfor %}
              </dl>
              {% if scope.needed %}
                <div class="scope-requirements">
                  <h4 class="scope-needed">{{ strings.summary.scope_needed.format(profile=scope.profile) }}</h4>
                  <ul class="scope-links" role="list">
                    {% for name, anchor in scope.needed %}
                      <li><a href="#replacement-{{ anchor.removeprefix('transfer-gap-') }}" class="area-link more symbol-label symbol-wrap"><span class="symbol-text">{{ name }}</span>{{ icon('chevron-right') }}</a></li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
              {% if scope.unknown_need %}
                {% set unknown = strings.summary.scope_unknown_one if scope.unknown_need == 1 else strings.summary.scope_unknown %}
                <p>{{ unknown.format(n=format.integer(scope.unknown_need), profile=scope.profile) }}</p>
              {% endif %}
              {% if scope.reviewed_on is none %}<p class="note-text">{{ strings.moves.unreviewed }}</p>{% endif %}
            </div>
          {% endif %}
          <div class="subsection summary-costs">
            <h3>{{ costs.total }}</h3>
            {% if (cost_tiles|rejectattr('result.total', 'none')|list) or (cost_tiles|rejectattr('known_blocks', 'none')|list) %}
              {{ cost_origin() }}
            {% endif %}
            <ul class="tiles tiles-3" role="list">
            {% for tile in cost_tiles %}
              {% set result = tile.result %}
              <li data-cost-tile="{{ result.id }}">
                <p class="tile-label">{{ costs[result.id] }}</p>
                {% if result.total is none %}
                  <span class="figure-num">{{ status_label('unknown') }}</span>
                  <p class="tile-title">{{
                    costs.known_blocks.format(amount=cost_amount(tile.known_blocks, whole=true)) if tile.known_blocks is not none else
                    (costs.stay_basis if result.id == 'stay' else costs.comparison_unknown)
                  }}</p>
                  <p>{{ missing_cost_link(result.missing_inputs|length) }}</p>
                {% else %}
                  <span class="figure-num">{{ cost_amount(result.total, whole=true) }}</span>
                  {% if result.id == 'stay' %}
                    <p class="tile-title">{{ costs.stay_basis }}</p>
                  {% elif tile.comparison.direction == 'unknown' %}
                    <p class="tile-title" data-comparison="unknown">
                      <span>{{ costs.comparison_unknown }} · {{ missing_cost_link(cost_tiles[0].result.missing_inputs|length) }}</span>
                    </p>
                  {% else %}
                    <p class="tile-title" data-comparison="{{ tile.comparison.direction }}">{{ cost_comparison(tile.comparison, whole=true) }}</p>
                  {% endif %}
                {% endif %}
              </li>
            {% endfor %}
            </ul>
            {{ cost_notes() }}
          </div>
        </div>
      </div>
    </section>
    <section data-section="path">
      <div class="sec grid">
        <h2 class="sec-label" id="path-title">{{ strings.path.title }}</h2>
        <div class="sec-body">
          <h3>{{ strings.path.even_if_staying }}</h3>
          {% if staying_steps %}{{ next_steps(staying_steps) }}{% endif %}
          <div class="subsection" data-subsection="not-examined">
            <h4 id="not-examined">{{ strings.readiness.missing }}</h4>
            {% if open_points %}
              <dl class="rows">
                {% for point in open_points %}{{ open_point(point) }}{% endfor %}
              </dl>
            {% else %}<p>{{ strings.path.empty.unknown }}</p>{% endif %}
          </div>
          {% if move_steps %}
            <h3>{{ strings.path.for_move }}</h3>
            {{ next_steps(move_steps) }}
          {% elif not open_points and not staying_steps %}
            <p>{{ strings.path.empty.blocker }}</p>
          {% endif %}
        </div>
      </div>
    </section>
    <section data-section="readiness">
      <div class="sec grid">
        <h2 class="sec-label" id="readiness-title">{{ strings.readiness.title }}</h2>
        <div class="sec-body">
          <div class="filters">
            <div class="filter-controls">
              <fieldset class="segmented" data-filter="status">
                <legend class="sr-only">{{ strings.filter.status_legend }}</legend>
                <label class="symbol-label">
                  <input class="sr-only" type="radio" name="f-status" id="f-status-all" checked>
                  <span class="symbol-text">{{ strings.filter.all }}</span> <span class="segment-count symbol-text">{{ format.integer(area_count) }}</span>
                </label>
                {% for status, count in status_counts %}
                  <label class="status {{ status }} symbol-label">
                    <input class="sr-only" type="radio" name="f-status" id="f-status-{{ status }}"{% if count == 0 %} disabled{% endif %}>
                    {{ status_contents(status) }} <span class="segment-count symbol-text">{{ format.integer(count) }}</span>
                  </label>
                {% endfor %}
              </fieldset>
              <select id="f-category" name="f-category" aria-label="{{ strings.filter.category_legend }}" class="category-filter" data-filter="category">
                <button type="button" class="symbol-label"><selectedcontent class="symbol-text"></selectedcontent>{{ icon('chevron-right') }}</button>
                {{ category_option('all', strings.filter.all_categories, selected=true) }}
                {% for category in categories %}
                  {{ category_option(category.id, category_labels[category.id]) }}
                {% endfor %}
              </select>
            </div>
            <p class="note-text">{{ strings.filter.search_hint }}</p>
          </div>
          <div class="areas readiness">
            {% for status, rows in status_groups %}
              <div class="status-group" data-status-group="{{ status }}">
                <h3 id="status-{{ status }}">{{ status_label(status) }}</h3>
                {% for row in rows %}
                  {% set category = workload_categories[row.workload] %}
                  <article data-workload="{{ row.workload }}" data-status="{{ row.status }}"{% if row.incomplete %} data-incomplete{% endif %} data-category="{{ category }}" class="finding" id="readiness-{{ row.workload }}" aria-labelledby="area-{{ row.workload }}">
                    <div class="finding-head">
                      <div>
                        <h4 class="finding-area" id="area-{{ row.workload }}">{{ workload_labels[row.workload] }}</h4>
                        <span class="finding-category">{{ category_labels[category] }}</span>
                      </div>
                      <p class="finding-status">{{ finding_badges(row) }}</p>
                    </div>
                    {% if row.reason_code %}{% set reason, fix = reason_text(row.reason_code) %}{% endif %}
                    <div class="finding-reason">
                      {% if row.reason_code %}<span data-reason="{{ row.reason_code }}">{{ reason }}</span>
                      {% else %}{{ status_reason(row) }}{% endif %}
                      {% if row.notes %}
                        <ul>
                          {% for rule in row.notes %}<li>{{ rule.reason[lang] }}</li>{% endfor %}
                        </ul>
                      {% endif %}
                    </div>
                    {% if row.status != 'ready' %}
                      <p class="finding-next"><strong>{{ strings.readiness.next_step }}</strong> {{ row.deciding.next_step.text[lang] if row.deciding else fix }}</p>
                    {% endif %}
                    {% if row.status != 'ready' and row.missing %}
                      <div class="finding-missing">
                        <p><strong>{{ strings.readiness.missing }}</strong></p>
                        <ul>
                          {% for gap in row.missing %}
                            {% set field = finding_inputs.get(gap.finding_id) %}
                            <li data-missing="{{ gap.finding_id }}">
                              <strong data-reason="{{ gap.reason_code }}">{{ evidence_question(gap.finding_id) }}</strong>
                              {{ open_details((finding_owners.get(gap.finding_id, 'licence_management'),), field, gap.collector) }}
                              {% if gap.reason_code != 'answer_not_provided' or not field %}
                                <p>{{ reason_detail(gap.reason_code) }}</p>
                              {% endif %}
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                    {% endif %}
                    {% set observations = catalogue_evidence[row.workload] %}
                    {% if observations or row.evidence %}
                      {% set counts = evidence_counts[row.workload] %}
                      <details class="workload-evidence" data-evidence-workload="{{ row.workload }}">
                        <summary id="evidence-{{ row.workload }}" class="symbol-label symbol-wrap">
                          {{ icon('chevron-right') }}
                          <span class="symbol-text">{{ strings.readiness.evidence }}
                            <small class="evidence-counts">{{ strings.readiness.evidence_summary.format(measured=format.integer(counts.measured), provided=format.integer(counts.provided), unknown=format.integer(counts.unknown)) }}</small>
                          </span>
                        </summary>
                        {% if row.evidence %}
                          <ul class="rule-evidence" role="list">
                            {% for finding in row.evidence %}
                              <li data-evidence="{{ finding.id }}">
                                <strong>{{ finding_labels[finding.id] }}</strong>
                                {{ evidence_pair(finding) }}
                                {% if finding.missing_reason %}<small>{{ reason_detail(finding.missing_reason) }}</small>{% endif %}
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                        {% if observations %}{{ finding_table(row.workload, observations) }}{% endif %}
                      </details>
                    {% endif %}
                    <p class="finding-target">
                      {% for item in target_functions[row.workload] %}
                        <span data-target-function="{{ item.function }}">{{ item.replacement[lang] }} · {{ strings.mapping_coverage[item.coverage] }} · {{ mapping_date(item) }}</span>
                      {% else %}
                        {{ strings.moves.no_function }}
                      {% endfor %}
                      <a class="more symbol-label symbol-wrap" href="#moves-title"><span class="symbol-text">{{ strings.readiness.all_replacements }}</span>{{ icon('chevron-right') }}</a>
                    </p>
                  </article>
                {% endfor %}
              </div>
            {% endfor %}
          </div>
          <p class="areas-empty note">{{ strings.filter.empty }}</p>
        </div>
      </div>
    </section>
    <section data-section="costs">
      <div class="sec grid">
        <h2 class="sec-label" id="costs-title">{{ costs.title }}</h2>
        <div class="sec-body">
          <p class="sec-intro">
            {{ inputs.organisation_name if inputs and inputs.organisation_name else strings.header.unnamed_organisation }}
            · {{ strings.header.scan_date }} <time datetime="{{ scan.generated_at }}">{{ format.date(scan.generated_at) }}</time>
            · {{ strings.header.inputs_date }}
            {% if inputs and inputs.as_of %}<time datetime="{{ inputs.as_of }}">{{ format.date(inputs.as_of) }}</time>
            {% elif inputs %}{{ strings.common.date_not_supplied }}
            {% else %}{{ costs.not_provided }}{% endif %}
            · {% if inputs %}<span data-cost-origin="{{ input_amount_origin }}">{{ costs.origins[input_amount_origin] }}</span>
            {%- else %}{{ costs.not_provided }}{% endif %}
          </p>
          <p class="note-text">{{ costs.profile_note }}</p>
          {% if cost_chart_rows %}
            {{ cost_origin() }}
            {{ cost_chart() }}
          {% else %}<p class="note">{{ costs.provide_inputs }}</p>{% endif %}
          {{ cost_notes() }}
          <h3 id="cost-results-title">{{ costs.results }}</h3>
          <div class="table-scroll" role="region" aria-labelledby="cost-results-title" tabindex="0">
            <table class="cost-table" role="table">
              {{ cost_caption() }}
              {{ cost_columns(costs.category) }}
              {% for block in cost_blocks %}
                <tbody data-block="{{ block.id }}" role="rowgroup">
                  <tr role="row">
                    <th scope="rowgroup" role="rowheader" colspan="{{ scenarios|length + 1 }}" data-label="{{ costs.category }}">{{ costs.groups[block.id] }}</th>
                  </tr>
                  {% for id, lines in block.lines %}
                    <tr role="row" data-cost-line="{{ id }}">
                      {{ cost_heading(costs.line_items[id]) }}
                      {% for line in lines %}
                        {% set result = scenarios[loop.index0] %}
                        <td role="cell" data-label="{{ costs[result.id] }}"{% if line %} data-amount="{{ plain_amount(line.amount) }}"{% endif %}>
                          {{ cost_amount(line.amount) if line else costs.not_applicable }}
                        </td>
                      {% endfor %}
                    </tr>
                  {% endfor %}
                  <tr class="subtotals" role="row">
                    {{ cost_heading(costs.subtotal) }}
                    {% for group in block.groups %}
                      <td role="cell" data-label="{{ costs[scenarios[loop.index0].id] }}" data-amount="{{ plain_amount(group.total) }}">{{ cost_amount(group.total) }}</td>
                    {% endfor %}
                  </tr>
                </tbody>
              {% endfor %}
              <tbody role="rowgroup">
                <tr class="totals" role="row">
                  {{ cost_heading(costs.total) }}
                  {% for result in scenarios %}
                    <td data-scenario="{{ result.id }}" data-total="{{ plain_amount(result.total) }}" role="cell" data-label="{{ costs[result.id] }}">{{ cost_amount(result.total) }}</td>
                  {% endfor %}
                </tr>
                <tr role="row">
                  {{ cost_heading(costs.difference) }}
                  {% for result in scenarios %}
                    <td role="cell" data-label="{{ costs[result.id] }}">{{ cost_amount(result.difference_to_stay) }}</td>
                  {% endfor %}
                </tr>
              </tbody>
            </table>
          </div>
          <p class="note-text">{{ costs.rounding }}</p>
          <p class="note-text">{{ costs.vat_note }}</p>
          {% if missing_cost_paths %}
            <div id="costs-missing">
              {% for result in scenarios if result.missing_inputs %}
                <h3>{{ costs.missing.format(scenario=costs[result.id]) }}</h3>
                <ul>
                  {% for path in result.missing_inputs %}
                    <li data-missing-cost="{{ path }}">{{ costs.input_fields[path.split('.')[-1]] }}</li>
                  {% endfor %}
                </ul>
              {% endfor %}
              <p>{{ costs.missing_fix }}</p>
            </div>
          {% endif %}
          <details class="cost-inputs">
            <summary id="cost-inputs-title" class="symbol-label symbol-wrap">{{ icon('chevron-right') }}<span class="symbol-text">{{ costs.inputs }}</span></summary>
            <div class="table-scroll" role="region" aria-labelledby="cost-inputs-title" tabindex="0">
              <table class="cost-table" role="table">
                {{ cost_caption() }}
                {{ cost_columns(costs.input) }}
                <tbody role="rowgroup">
                  {% for field, amount in current_costs.items() %}
                    {{ cost_input_row(field, [amount] * (scenarios|length), shared=true) }}
                  {% endfor %}
                  {% for field in target_costs[0] %}
                    {{ cost_input_row(field, (none, target_costs[0][field], target_costs[1][field])) }}
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </details>
        </div>
      </div>
    </section>
    <section data-section="moves">
      <div class="sec grid">
        <h2 class="sec-label" id="moves-title">{{ strings.moves.title }}</h2>
        <div class="sec-body">
          {{ mapping_review() }}
          {% set check_dates = mapping.functions|map(attribute='checked_on')|unique|list %}
          {% set shared_check = check_dates|length == 1 and check_dates[0] is not none %}
          {% set coverage_icons = {
            'in_suite': 'circle',
            'in_suite_with_limits': 'contrast',
            'open_source_community': 'code',
            'open_source_third_party': 'code',
            'announced': 'cancel',
            'component_vendor_solution': 'cancel',
            'proprietary_third_party': 'cancel',
            'transfer_undocumented': 'cancel',
            'not_available': 'cancel'
          } %}
          <div class="table-scroll" role="region" aria-labelledby="moves-title" tabindex="0">
            <table class="coverage replacements" role="table">
              {% if sample_scan or shared_check %}
                <caption{% if sample_scan %} data-sample{% endif %}>
                  {% if sample_scan %}{{ strings.found.sample }}{% endif %}
                  {% if shared_check %}<span class="checked-on">{{ strings.appendix.mapping_date }} {{ mapping_date(mapping.functions[0]) }}</span>{% endif %}
                </caption>
              {% endif %}
              <thead role="rowgroup">
                <tr role="row">
                  {{ column(strings.moves.microsoft) }}
                  {{ column(strings.moves.replacement) }}
                  {{ column(strings.moves.need) }}
                  {% if not shared_check %}{{ column(strings.appendix.mapping_date) }}{% endif %}
                  {{ column(strings.moves.workload_status) }}
                </tr>
              </thead>
              <tbody role="rowgroup">
                {% for item in mapping.functions %}
                  {% set row = status_by_workload[item.workload] %}
                  {% set symbol = coverage_icons[item.coverage] %}
                  {% set gap = row.transfer_gaps|selectattr('mapping.function', 'eq', item.function)|first|default(none) %}
                  <tr data-function="{{ item.function }}" data-workload="{{ item.workload }}" data-status="{{ row.status }}" role="row" id="replacement-{{ item.function }}">
                    <th scope="row" role="rowheader" data-label="{{ strings.moves.microsoft }}">{{ item.microsoft[lang] }}</th>
                    <td role="cell" data-label="{{ strings.moves.replacement }}" data-coverage-label="{{ strings.moves.coverage }}">
                      <span class="cov-cell{{ ' cov-none' if symbol == 'cancel' }} symbol-label symbol-wrap">
                        {{ icon(symbol) }}
                        <strong class="symbol-text">{{ strings.mapping_coverage[item.coverage] }}</strong>
                      </span>
                      <span class="replacement-name" data-label="{{ strings.moves.replacement }}">{{ item.replacement[lang] }}</span>
                    </td>
                    <td role="cell" data-label="{{ strings.moves.need }}">
                      {% if gap and gap.need != 'unknown' %}
                        {{ strings.common[gap.need] }}
                        <small class="prov">{{ provenance_word(gap.finding.provenance) }}</small>
                      {% elif gap %}
                        {{ strings.status.unknown }}
                      {% else %}
                        {{ strings.moves.need_not_assessed }}
                      {% endif %}
                    </td>
                    {% if not shared_check %}<td role="cell" data-label="{{ strings.appendix.mapping_date }}">{{ mapping_date(item) }}</td>{% endif %}
                    <td role="cell" data-label="{{ strings.moves.workload_status }}">
                      <a href="#readiness-{{ item.workload }}" aria-label="{{ strings.moves.status_link.format(area=workload_labels[item.workload], status=strings.status[row.status]) }}" class="area-link replacement-status status {{ row.status }} badge symbol-label">{{ status_contents(row.status) }}{{ icon('chevron-right') }}</a>
                      {% if row.incomplete %}{{ incomplete_badge() }}{% endif %}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% for workload in mapping.no_function %}
            <p class="note-text">{{ strings.moves.licences_excluded if workload == 'licences' else strings.moves.area_excluded.format(area=workload_labels[workload]) }}</p>
          {% endfor %}
        </div>
      </div>
    </section>
    <section data-section="attention">
      <div class="sec grid">
        <h2 class="sec-label" id="attention-title">{{ strings.attention.title }}</h2>
        <div class="sec-body">
          <h3 id="risky-files-title">{{ strings.attention.files }}</h3>
          <div class="table-scroll" role="region" aria-labelledby="risky-files-title" tabindex="0">
            <table class="coverage file-types" role="table">
              {% if sample_scan %}<caption data-sample>{{ strings.found.sample }}</caption>{% endif %}
              <thead role="rowgroup">
                <tr role="row">
                  {{ column(strings.attention.file_kind) }}
                  {{ column(strings.attention.extensions) }}
                  {{ column(strings.attention.count) }}
                  {{ column(strings.found.note) }}
                </tr>
              </thead>
              <tbody role="rowgroup">
                {% for kind, finding in risky_files %}
                  <tr data-kind="{{ kind.id }}" role="row">
                    <th scope="row" role="rowheader" data-label="{{ strings.attention.file_kind }}">{{ kind.label[lang] }}</th>
                    <td role="cell" data-label="{{ strings.attention.extensions }}">
                      {% for extension in kind.extensions %}<code>.{{ extension }}</code>{{ ', ' if not loop.last }}{% endfor %}
                    </td>
                    <td role="cell" data-label="{{ strings.attention.count }}">
                      {{ attention_evidence(finding) }}
                      {% if finding and finding.value == 0 and finding.id not in conflicts and finding.id not in answer_conflicts and (not finding.coverage or finding.coverage.kind == 'complete') %}
                        <small>{{ strings.attention.none_reported }}</small>
                      {% endif %}
                    </td>
                    <td role="cell" data-label="{{ strings.found.note }}">{{ kind.note[lang] }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          <h3 id="software-title">{{ strings.attention.software }}</h3>
          <dl class="rows">
            {% for entry, finding in software %}
              <div>
                <dt>{{ label(entry.label) }}</dt>
                <dd data-software-count="{{ entry.id }}">{{ attention_evidence(finding) }}</dd>
              </div>
            {% endfor %}
          </dl>
          {% if inputs and inputs.windows_only_software %}
            <div class="table-scroll" role="region" aria-labelledby="software-title" tabindex="0">
              <table class="coverage software-table" role="table">
                <thead role="rowgroup">
                  <tr role="row">
                    {{ column(strings.attention.software_name) }}
                    {{ column(strings.attention.software_users) }}
                    {{ column(strings.attention.software_web_version) }}
                  </tr>
                </thead>
                <tbody role="rowgroup">
                  {% for item in inputs.windows_only_software %}
                    <tr data-software-entry data-provenance="provided" role="row">
                      <th scope="row" role="rowheader" data-label="{{ strings.attention.software_name }}">
                        {{ item.name }} <span class="prov">{{ strings.provenance.provided }}</span>
                        <small>{{ code_label('source', inputs.answer_source) }} · {{ format.date(inputs.as_of) if inputs.as_of else strings.common.date_not_supplied }}</small>
                      </th>
                      <td role="cell" data-label="{{ strings.attention.software_users }}">
                        {% if item.users is none %}{{ missing_answer() }}{% else %}<span>{{ format.integer(item.users) }}</span>{% endif %}
                      </td>
                      <td role="cell" data-label="{{ strings.attention.software_web_version }}">
                        {% if item.vendor_has_web_version is none %}{{ missing_answer() }}{% else %}<span>{{ literal_text(item.vendor_has_web_version) }}</span>{% endif %}
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% endif %}
          <div data-subsection="cannot-be-moved">
            <h3>{{ strings.attention.cannot_be_moved }}</h3>
            {% if mapping_gaps %}
              <p>{{ strings.attention.gap_scope }}</p>
              <ul class="mapping-gaps" role="list">
                {% for gap in mapping_gaps %}{% set item = gap.mapping %}
                  <li data-gap="{{ item.function }}" data-need="{{ gap.need }}">
                    <strong id="transfer-gap-{{ item.function }}">{{ item.microsoft[lang] }}</strong>
                    <p>{{ item.note[lang] if item.note else strings.mapping_coverage[item.coverage] }}</p>
                    <p data-provenance="{{ 'unknown' if gap.need == 'unknown' else gap.finding.provenance }}">
                      <strong>{{ strings.attention.needed_here }}</strong> · {{ strings.status.unknown if gap.need == 'unknown' else strings.common[gap.need] }}
                      {% if gap.need == 'unknown' %}
                        {% for reason in gap.reasons %}<small>{{ reason_detail(reason) }}</small>{% endfor %}
                      {% else %}{% set finding = gap.finding %}
                        <small>
                          {{ finding_labels[finding.id] }} · <span class="prov">{{ provenance_word(finding.provenance) }}</span>
                          · {{ finding_source(finding) }} · {{ finding_date(finding) }}
                        </small>
                      {% endif %}
                    </p>
                    {{ mapping_reference(item.reference_url) }}
                    <small>{{ strings.appendix.mapping_date }} · {{ mapping_date(item) }}</small>
                  </li>
                {% endfor %}
              </ul>
            {% else %}<p>{{ strings.attention.no_gaps }}</p>{% endif %}
          </div>
        </div>
      </div>
    </section>
    <section data-section="found">
      <div class="sec grid">
        <h2 class="sec-label">{{ strings.found.title_sample if sample_scan else strings.found.title }}</h2>
        <div class="sec-body">
          <ul class="tiles tiles-2" role="list">
            {% for entry, finding in headlines %}
              {% set provenance = finding.provenance if finding else 'unknown' %}
              <li data-provenance="{{ provenance }}">
                <strong class="tile-label">{{ label(entry.label) }}</strong>
                {% if finding and finding.value is not none %}<span class="figure-num">{{ value_text(finding) }}</span>{% endif %}
                <span class="prov">{{ provenance_word(provenance) }}</span>
                {% if provenance == 'unknown' %}
                  {% set code = finding.missing_reason if finding else ('not_in_scan' if entry.provided == 'no' else 'answer_not_provided') %}
                  {% set reason, fix = reason_text(code) %}
                  <small data-reason="{{ code }}">{{ reason }} {{ fix }}</small>
                {% elif provenance == 'provided' %}
                  <small>{{ finding_source(finding) }} · {{ finding_date(finding) }}</small>
                {% endif %}
                {% if finding %}{{ alternative_evidence(finding, compact=true) }}{% endif %}
              </li>
            {% endfor %}
          </ul>
          {% set licence_provenance = provenance_word(product_count.provenance if product_count else 'unknown') %}
          <details class="licence-products">
            <summary id="licences-title" class="symbol-label symbol-wrap">
              {{ icon('chevron-right') }}
              <span class="symbol-text">
                {% if product_count and product_count.value is not none %}
                  {{ strings.licences.product_count.format(count=format.integer(product_count.value)) }} · {{ licence_provenance }}
                {% else %}{{ strings.licences.title }} · {{ status_label('unknown') }}{% endif %}
              </span>
            </summary>
            {% if product_count %}
              <p data-provenance="{{ product_count.provenance }}">
                {% if product_count.value is not none and not licences %}{{ strings.licences.product_count.format(count=format.integer(product_count.value)) }}{% endif %}
                <span class="prov">{{ licence_provenance }}</span>
                {% if product_count.missing_reason %}
                  <small>{{ reason_detail(product_count.missing_reason) }}</small>
                {% elif product_count.coverage.kind in ('partial', 'unknown') %}
                  <small>{{ reason_detail('coverage_' ~ product_count.coverage.kind) }}</small>
                {% endif %}
                <small>{{ code_label('source', product_count.source) }} · {{ format.date(product_count.collected_at) }} · {{ coverage_text(product_count.coverage) }}</small>
              </p>
              {% if licence_plan_list_incomplete %}
                <p>{{ reason_detail('licence_plan_list_incomplete') }}</p>
              {% endif %}
              {% if licences %}
                {% if sample_scan %}<p class="table-note" data-sample>{{ strings.found.sample }}</p>{% endif %}
                <dl class="rows">
                  {% for product in licences %}
                    {% set matches = product.plans %}
                    <div data-product="{{ product.id }}" data-provenance="measured">
                      <dt>{{ product.label }}</dt>
                      <dd>
                        <small class="prov">{{ licence_provenance }}</small>
                        {% if product.sku_guid %}<small><code>{{ product.sku_guid }}</code></small>{% endif %}
                        <dl class="report-meta">
                          <div><dt>{{ strings.licences.purchased }}</dt><dd>{{ format.integer(product.purchased) }}</dd></div>
                          <div><dt>{{ strings.licences.assigned }}</dt><dd>{{ format.integer(product.assigned) }}</dd></div>
                        </dl>
                        {% if product.assigned > product.purchased %}
                          <small data-reason="assigned_exceeds_purchased">{{ strings.licences.assigned_exceeds_purchased.format(count=format.integer(product.assigned - product.purchased)) }}</small>
                        {% endif %}
                        <div class="licence-plans">
                          <p><strong>{{ strings.licences.plans }}</strong></p>
                          {% set classified = matches|reject('none')|list %}
                          {% for workload, entries in classified|rejectattr('workload', 'none')|groupby('workload') %}
                            {% for signal, plans in entries|groupby('signal') %}
                              <div class="licence-plan">
                                {{ workload_labels[workload] }} · {{ strings.licences[signal] }}
                                <small>{% for plan in plans %}{{ wrapped_code(plan.name, '_') }}{% if not loop.last %}, {% endif %}{% endfor %}</small>
                              </div>
                            {% endfor %}
                          {% endfor %}
                          {% set no_workload = classified|selectattr('signal', 'eq', 'no_workload')|list|length %}
                          {% if no_workload %}
                            <div>{{ strings.licences.no_workload.format(count=format.integer(no_workload)) }}</div>
                          {% endif %}
                          {% set unclassified = matches|select('none')|list|length %}
                          {% if unclassified %}
                            {{ strings.licences.unclassified.format(count=format.integer(unclassified)) }}
                            {% set reason, fix = reason_text('licence_not_classified') %}
                            <small data-reason="licence_not_classified">{{ reason }} {{ fix }}</small>
                          {% elif not matches and product.assigned %}
                            {{ reason_detail('licence_plan_list_missing') }}
                          {% elif not matches %}
                            {{ strings.common.unavailable }}
                          {% endif %}
                        </div>
                      </dd>
                    </div>
                  {% endfor %}
                </dl>
              {% endif %}
            {% else %}
              <p data-provenance="unknown">
                <span class="prov">{{ strings.provenance.unknown }}</span>
                <small>{{ reason_detail('not_in_scan') }}</small>
              </p>
            {% endif %}
          </details>
          {% for workload in inventory_workloads if catalogue_evidence[workload] %}
            <details class="workload-evidence" data-evidence-workload="{{ workload }}">
              <summary id="evidence-{{ workload }}" class="symbol-label symbol-wrap">{{ icon('chevron-right') }}<span class="symbol-text">{{ workload_labels[workload] }}</span></summary>
              {{ finding_table(workload, catalogue_evidence[workload]) }}
            </details>
          {% endfor %}
        </div>
      </div>
    </section>
    <section data-section="appendix">
      <div class="sec grid">
        <h2 class="sec-label" id="appendix-title">{{ strings.appendix.title }}</h2>
        <div class="sec-body">
          <details>
            <summary class="symbol-label symbol-wrap">{{ icon('chevron-right') }}<span class="symbol-text">{{ strings.appendix.collectors }}</span></summary>
            {% if sample_scan %}<p>{{ strings.appendix.sample_permissions }}</p>{% endif %}
            <div class="table-scroll" role="region" aria-label="{{ strings.appendix.collectors }}" tabindex="0">
              <table class="coverage" role="table">
                <thead role="rowgroup">
                  <tr role="row">
                    {{ column(strings.found.collector) }}
                    {{ column(strings.appendix.status) }}
                    {{ column(strings.appendix.reason) }}
                    {{ column(strings.appendix.permissions) }}
                  </tr>
                </thead>
                <tbody role="rowgroup">
                  {% for collector in scan.collectors %}
                    <tr data-collector="{{ collector.id }}" role="row">
                      <th scope="row" role="rowheader" data-label="{{ strings.found.collector }}">{{ code_label('collector', collector.id) }}</th>
                      <td role="cell" data-label="{{ strings.appendix.status }}">{{ code_label('collector_status', collector.status) }}</td>
                      <td role="cell" data-label="{{ strings.appendix.reason }}">
                        {% if collector.reason %}
                          {% set reason, fix = reason_text(collector.reason) %}
                          <span data-reason="{{ collector.reason }}">{{ reason }}</span> {{ fix }}
                        {% else %}{{ strings.common.unavailable }}{% endif %}
                      </td>
                      <td role="cell" data-label="{{ strings.appendix.permissions }}">{{ collector.permissions_used|join(', ') or strings.common.unavailable }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            {% if scan.dropped_count %}
              <p data-ignored-count="{{ scan.dropped_count }}">{{ strings.appendix.ignored.format(count=format.integer(scan.dropped_count)) }}</p>
            {% endif %}
          </details>
          <details>
            <summary class="symbol-label symbol-wrap">{{ icon('chevron-right') }}<span class="symbol-text">{{ strings.appendix.rules }}</span></summary>
            <p>{{ strings.appendix.rule_file }} · <code>{{ status_rules.file_name }}</code></p>
            <dl class="rule-details">
              {% for row in statuses %}
                <dt>{{ workload_labels[row.workload] }}</dt>
                <dd>
                  {% set block = status_rules.workloads[row.workload] %}
                  {{ strings.appendix.ready_evidence }}
                  {{ conditions_list(block.ready) }}
                  {% set fired = ([row.deciding] if row.deciding else []) + row.notes|list %}
                  {% set workload_rules = block.rules|select('in', fired)|list %}
                  {% set target_rules = fired|reject('in', block.rules)|list %}
                  {% for rule in workload_rules + target_rules %}
                    <div data-rule="{{ rule.id }}">
                      <code>{{ rule.id }}</code> · {{ status_label(rule.status) }} · {{ rule.reason[lang] }}
                      {{ conditions_list(rule.when) }}
                    </div>
                  {% endfor %}
                </dd>
              {% endfor %}
            </dl>
          </details>
          <details>
            <summary class="symbol-label symbol-wrap">{{ icon('chevron-right') }}<span class="symbol-text">{{ strings.appendix.mapping }}</span></summary>
            <p>{{ mapping.description[lang] }}</p>
            {{ mapping_review() }}
            <p>{{ strings.appendix.mapping_file }} · <code>{{ mapping.file_name }}</code></p>
            <dl class="mapping-details">
              {% for item in mapping.functions %}
                <dt>{{ item.microsoft[lang] }} <small>{{ workload_labels[item.workload] }}</small></dt>
                <dd data-mapping-details="{{ item.function }}">
                  <p>{{ item.replacement[lang] }}</p>
                  <small>{{ strings.mapping_coverage[item.coverage] }}</small>
                  {% if item.note %}<p>{{ item.note[lang] }}</p>{% endif %}
                  {{ mapping_reference(item.reference_url) }}
                  <small>{{ strings.appendix.mapping_date }} · {{ mapping_date(item) }}</small>
                </dd>
              {% endfor %}
            </dl>
          </details>
          <details>
            <summary class="symbol-label symbol-wrap">{{ icon('chevron-right') }}<span class="symbol-text">{{ costs.formulas_title }}</span></summary>
            <ul>
              {% for formula in costs.formulas %}<li>{{ formula }}</li>{% endfor %}
            </ul>
          </details>
          <div class="subsection">
            <h3>{{ strings.appendix.not_looked }}</h3>
            <p>{{ strings.appendix.not_looked_text }}</p>
          </div>
          <div data-subsection="run-details">
            <h3>{{ strings.appendix.run_details }}</h3>
            <p>{{ strings.header.local }}</p>
            <p class="muted">{{ strings.header.offline }}</p>
            <dl class="report-meta">
              <div><dt>{{ strings.appendix.schema_version }}</dt><dd>{{ scan.schema_version }}</dd></div>
              <div><dt>{{ strings.appendix.scan_origin }}</dt><dd data-source-kind="{{ scan.source_kind }}">{{ strings.source_kind[scan.source_kind] }}</dd></div>
              <div><dt>{{ strings.appendix.scan_producer }}</dt><dd data-scan-producer>{{ scan.tool.name }}</dd></div>
              <div><dt>{{ strings.appendix.producer_version }}</dt><dd data-producer-version>{{ scan.tool.version }}</dd></div>
              <div><dt>{{ strings.appendix.renderer_version }}</dt><dd data-renderer-version>{{ tool_version }}</dd></div>
            </dl>
            <dl class="run-details">
              <dt>{{ strings.appendix.scan_role }}</dt>
              <dd><time datetime="{{ scan.generated_at }}">{{ format.date(scan.generated_at) }}</time></dd>
              <dt>{{ strings.appendix.scan_periods }}</dt>
              <dd>
                {% if scan_periods %}
                  <ul>
                    {% for period in scan_periods %}
                      <li data-reporting-period="{{ period }}">{{ format.period(period) }}</li>
                    {% endfor %}
                  </ul>
                {% else %}{{ strings.appendix.no_scan_periods }}{% endif %}
              </dd>
              <dt>{{ strings.appendix.inputs_role }}</dt>
              <dd>
                {% if inputs and inputs.as_of %}<time datetime="{{ inputs.as_of }}">{{ format.date(inputs.as_of) }}</time>
                {% else %}{{ strings.common.date_not_supplied }}{% endif %}
              </dd>
            </dl>
            <p>{{ strings.appendix.checksums }}</p>
            <ul>
              {% for name, checksum in checksums.items() %}
                <li><code>{{ name }}</code> · <code data-checksum="{{ name }}">{{ checksum }}</code></li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
  <footer data-section="footer">
    <p>{{ project_name }} · {{ repository_url }}</p>
  </footer>
</body>
</html>
