{# SPDX-License-Identifier: AGPL-3.0-or-later #}
{% macro column(text) -%}
  <th scope="col" role="columnheader" data-label="{{ text }}">{{ text }}</th>
{%- endmacro %}
{% macro reason_detail(code) -%}
  {% set reason, fix = reason_text(code) %}
  <span data-reason="{{ code }}">{{ reason }} {{ fix }}</span>
{%- endmacro %}
{% macro finding_date(finding) -%}
  {% if finding.collected_at %}{{ format.date(finding.collected_at) }}
  {%- elif finding.provenance == 'provided' or finding.source in provided_sources %}{{ strings.common.date_not_supplied }}
  {%- else %}{{ strings.common.unavailable }}{% endif %}
{%- endmacro %}
{% macro finding_source(finding) -%}
  {{ code_label('source', finding.source) if finding.source else strings.common.unavailable }}
{%- endmacro %}
{% macro finding_coverage(finding) -%}
  {{ coverage_text(finding.coverage, provided=finding.provenance == 'provided' or finding.source in provided_sources) }}
{%- endmacro %}
{% macro provenance_word(provenance) -%}
  {{ strings.provenance.measured_sample if sample_scan and provenance == 'measured' else strings.provenance[provenance] }}
{%- endmacro %}
{% macro evidence_summary(finding, compact=false) -%}
  <div data-provenance="{{ finding.provenance }}">
    {% if finding.value is not none %}{{ value_text(finding) }}{% endif %}
    {% set provided = finding.provenance == 'provided' %}
    <small class="evidence-meta"><span class="prov">{{ provenance_word(finding.provenance) }}</span>
      {%- if finding.source and (provided or not compact) %} · {{ finding_source(finding) }}{% endif %}
      {%- if provided or (finding.collected_at and not compact) %} · {{ finding_date(finding) }}{% endif %}
      {%- if finding.period and not compact %} · {{ format.period(finding.period) }}{% endif %}
      {%- if finding.coverage and (not compact or finding.coverage.kind != 'complete') %} · {{ finding_coverage(finding) }}{% endif -%}
    </small>
  </div>
{%- endmacro %}
{% macro alternative_evidence(finding, compact=false) -%}
  {% if finding.id in alternatives %}
    {% set alternative = alternatives[finding.id] %}
    <small>{{ strings.found.comparison }}</small>
    {{ evidence_summary(alternative, compact) }}
    {% if alternative.missing_reason %}<small>{{ reason_detail(alternative.missing_reason) }}</small>{% endif %}
    {% if finding.id in conflicts %}
      <small>{{ strings.readiness.conflict if finding.is_lower_bound else strings.reason.confirmation_conflict.label }}</small>
    {% endif %}
    {% if finding.id in answer_conflicts %}<small>{{ strings.reason.provided_answers_conflict.label }}</small>{% endif %}
  {% endif %}
{%- endmacro %}
{% macro evidence_pair(finding) -%}
  {{ evidence_summary(finding) }}
  {{ alternative_evidence(finding) }}
{%- endmacro %}
{% macro finding_table(workload, observations) -%}
  <div class="table-scroll" role="region" aria-labelledby="evidence-{{ workload }}" tabindex="0">
    <table class="coverage" role="table">
      {% if sample_scan %}<caption data-sample>{{ strings.found.sample }}</caption>{% endif %}
      <thead role="rowgroup">
        <tr role="row">
          {{ column(strings.found.finding) }}
          {{ column(strings.found.value) }}
        </tr>
      </thead>
      <tbody role="rowgroup">
        {% for entry, finding in observations %}
          <tr data-finding="{{ finding.id }}" data-provenance="{{ finding.provenance }}" role="row">
            <th scope="row" role="rowheader" data-label="{{ strings.found.finding }}">{{ label(entry.label) }}</th>
            <td role="cell" data-label="{{ strings.found.value }}">
              {{ evidence_pair(finding) }}
              {% if finding.collector %}
                <small>{{ strings.found.collector }} · {{ code_label('collector', finding.collector) }}</small>
              {% endif %}
              {% if finding.missing_reason %}<small>{{ reason_detail(finding.missing_reason) }}</small>{% endif %}
            </td>
          </tr>
        {% endfor %}
        {% set note = strings.found.notes.get(workload) %}
        {% if sample_scan and note %}
          <tr role="row"><td class="table-note" role="cell" colspan="2" data-label="{{ strings.found.note }}">{{ note }}</td></tr>
        {% endif %}
      </tbody>
    </table>
  </div>
{%- endmacro %}
{% macro attention_evidence(finding) -%}
  {% if finding %}
    {{ evidence_pair(finding) }}
    {% if finding.missing_reason %}
      <small>{{ reason_detail(finding.missing_reason) }}</small>
    {% elif finding.provenance == 'provided' and finding.coverage and finding.coverage.kind == 'partial' %}
      <small>{{ reason_detail('answer_not_provided') }}</small>
    {% endif %}
  {% else %}
    <div data-provenance="unknown">
      <span class="prov">{{ strings.provenance.unknown }}</span>
      <small>{{ reason_detail('answer_not_provided') }}</small>
    </div>
  {% endif %}
{%- endmacro %}
{% macro missing_answer() -%}
  <span data-provenance="unknown">
    {{ strings.common.not_stated }}
    <small>{{ reason_detail('answer_not_provided') }}</small>
  </span>
{%- endmacro %}
{% macro icon(name) -%}
  <svg class="icon symbol{{ ' chevron' if name == 'chevron-right' }}" viewBox="0 -960 960 960" aria-hidden="true" focusable="false"><path d="{{ icons[name] }}"/></svg>
{%- endmacro %}
{% set index_sections = (
  ('summary', 'summary'), ('path', 'next_steps'), ('readiness', 'areas'),
  ('costs', 'costs'), ('moves', 'replacements'), ('attention', 'closer_look'), ('appendix', 'appendix')
) %}
{% macro bar_links() -%}
  <nav class="bar-links" aria-label="{{ strings.nav.label }}">
    <div class="bar-links-in">
      {% for section, key in index_sections %}
        <a href="#{{ section }}-title" class="symbol-label"><span class="symbol-text">{{ strings.nav[key] }}</span></a>
      {% endfor %}
    </div>
  </nav>
{%- endmacro %}
{% macro status_contents(status) -%}
  {{ icon({'ready': 'check-circle', 'needs_work': 'warning', 'blocker': 'report', 'unknown': 'help'}[status]) }}<span class="symbol-text">{{ strings.status[status] }}</span>
{%- endmacro %}
{% macro status_label(status, badge=false) -%}
  <span class="status {{ status }}{{ ' badge' if badge }} symbol-label">{{ status_contents(status) }}</span>
{%- endmacro %}
{% macro incomplete_badge() -%}
  <span class="badge symbol-label"><span class="symbol-text">{{ strings.readiness.incomplete }}</span></span>
{%- endmacro %}
{% macro finding_badges(row) -%}
  {{ status_label(row.status, badge=true) }}
  {% if row.incomplete %}{{ incomplete_badge() }}{% endif %}
{%- endmacro %}
{% macro area_link(workload, unexamined=false) -%}
  <a href="#readiness-{{ workload }}"{% if unexamined and status_by_workload[workload].status == 'unknown' %} data-unexamined-workload="{{ workload }}"{% endif %} class="area-link more symbol-label symbol-wrap"><span class="symbol-text">{{ workload_labels[workload] }}</span>{{ icon('chevron-right') }}</a>
{%- endmacro %}
{% macro summary_area(row) -%}
  <dt class="finding-head">
    <div>
      <a href="#readiness-{{ row.workload }}" class="finding-area area-link more symbol-label symbol-wrap"><span class="symbol-text">{{ workload_labels[row.workload] }}</span>{{ icon('chevron-right') }}</a>
      <span class="finding-category">{{ category_labels[workload_categories[row.workload]] }}</span>
    </div>
    <span class="finding-status">{{ finding_badges(row) }}</span>
  </dt>
{%- endmacro %}
{% macro status_reason(row) -%}
  {% if row.deciding %}{{ row.deciding.reason[lang] }}
  {% elif row.reason_code %}{{ reason_detail(row.reason_code) }}
  {% else %}{{ status_rules.workloads[row.workload].ready_reason[lang] }}{% endif %}
{%- endmacro %}
{% macro mapping_date(row) -%}
  {% if row.checked_on %}
    {% set day = row.checked_on.isoformat() %}
    <time datetime="{{ day }}">{{ format.date(day) }}</time>
  {% else %}{{ strings.moves.no_project_check }}{% endif %}
{%- endmacro %}
{% macro mapping_review() -%}
  {% if mapping.reviewed_on %}
    {% set day = mapping.reviewed_on.isoformat() %}
    <p data-mapping-review="{{ day }}">{{ strings.moves.reviewed.format(date=format.date(day)) }}</p>
  {% else -%}
    <p data-mapping-review="unreviewed">{{ strings.moves.unreviewed }}</p>
  {% endif %}
{%- endmacro %}
{% macro mapping_reference(url) -%}
  <small>{{ strings.appendix.mapping_reference }} ·
    {% for part in (url or strings.common.unavailable).split('#', 1) -%}
      {%- if not loop.first %}<wbr>#{% endif -%}{{ part }}
    {%- endfor %}
  </small>
{%- endmacro %}
{% macro wrapped_code(value, separator) -%}
  <code>{% for part in value.split(separator) %}{{ part }}{% if not loop.last %}{{ separator }}<wbr>{% endif %}{% endfor %}</code>
{%- endmacro %}
{% macro conditions_list(conditions) -%}
  <ul>
    {% for condition in conditions %}
      <li>
        {{ finding_labels[condition.finding] }}
        {% if condition.op == 'exists' %}{{ strings.appendix.condition_exists }}
        {% else %}<span class="condition-value">{{ condition.op }} {{ literal_text(condition.value) }}</span>{% endif %}
        {% if condition.provenance %}<span class="prov">{{ strings.provenance[condition.provenance] }}</span>{% endif %}
      </li>
    {% endfor %}
  </ul>
{%- endmacro %}
{% macro next_steps(steps) -%}
  <dl class="rows">
    {% for workload, actions in steps.items() %}
      <div>
        <dt>{{ area_link(workload) }}</dt>
        <dd>
          <ul class="path-actions">
            {% for action in actions %}<li data-step-kind="{{ action.kind }}">{{ action.text }}</li>{% endfor %}
          </ul>
        </dd>
      </div>
    {% endfor %}
  </dl>
{%- endmacro %}
{% macro evidence_question(finding_id) -%}
  {{ strings.path.questions.get(finding_id) or strings.path.finding_question.format(finding=finding_labels[finding_id]) }}
{%- endmacro %}
{% macro open_details(owners, input_key, collector, skipped=none) -%}
  <p><span class="open-label">{{ strings.path.who_answers }}</span>
    {% for owner in owners %}{{ strings.role[owner] }}{{ ' · ' if not loop.last }}{% endfor %}
  </p>
  {% if input_key %}
    <p><span class="open-label">{{ strings.path.input_field }}</span> {{ wrapped_code(input_key, '.') }}</p>
  {% endif %}
  {% if collector or not input_key %}
    <p{% if skipped %} data-unexamined-collector="{{ skipped.id }}" data-reason="{{ skipped.reasons[0] }}"{% endif %}>
      <span class="open-label">{{ strings.path.source }}</span>
      {{ code_label('collector', collector) if collector else strings.common.not_stated }}
    </p>
  {% endif %}
{%- endmacro %}
{% macro open_point(point) -%}
  {% set skipped = point.items|selectattr('kind', 'eq', 'collector')|first|default(none) %}
  <div>
    <dt data-open-point="{{ point.key }}">
      {% for item in point.items if item.kind != 'collector' %}
        <span class="open-question"{% if item.unknown %} data-unexamined-finding="{{ item.id }}"{% endif %}{% if item.gap %} data-unexamined-gap="{{ item.id }}" data-areas="{{ item.areas|join(' ') }}"{% endif %}>
          {{ evidence_question(item.id) if item.kind == 'finding' else strings.path.area_question.format(area=workload_labels[item.id]) }}
        </span>
      {% else %}{{ strings.path.collector_question }}{% endfor %}
    </dt>
    <dd class="open-details">
      {% if point.areas %}
        <p>{% for area in point.areas %}{{ area_link(area, unexamined=true) }}{{ ' · ' if not loop.last }}{% endfor %}</p>
      {% endif %}
      {{ open_details(point.owners, point.input_key, point.collector, skipped) }}
      {% set reasons = point.reasons|reject('eq', 'answer_not_provided')|list if point.input_key else point.reasons %}
      {% if reasons %}<p>{{ strings.path.guidance.get(reasons[0]) or reason_text(reasons[0])[1] }}</p>{% endif %}
    </dd>
  </div>
{%- endmacro %}
{% set costs = strings.costs %}
{% set prices_invented = inputs and inputs.amounts_are_invented %}
{% set calculation_origin = 'calculated_with_examples' if prices_invented else 'calculated' %}
{% set input_amount_origin = 'invented' if prices_invented else 'provided' %}
{% macro cost_columns(label) -%}
  <thead role="rowgroup">
    <tr role="row">
      {{ column(label) }}
      {% for result in scenarios %}{{ column(costs[result.id]) }}{% endfor %}
    </tr>
  </thead>
{%- endmacro %}
{% macro cost_caption() -%}
  {% if prices_invented %}<caption data-invented-amounts>{{ costs.invented_amounts }}</caption>{% endif %}
{%- endmacro %}
{% macro cost_input_row(field, amounts, shared=false) -%}
  {% set quantity = field in ('users', 'training_staff', 'training_days_per_person', 'parallel_running_months') %}
  <tr data-cost-input="{{ field }}" role="row">
    <th scope="row" role="rowheader" data-label="{{ costs.input }}">
      {{ costs.input_fields[field] }}
      {% set origin = ('sample_input' if inputs and inputs.answers_are_sample else 'provided') if quantity else input_amount_origin %}
      {% if origin != input_amount_origin and amounts|reject('none')|list %}
        <small data-cost-origin="{{ origin }}">{{ costs.origins[origin] }}</small>
      {% endif %}
    </th>
    {% for result in scenarios %}
      {% set amount = amounts[loop.index0] %}
      <td role="cell" data-label="{{ costs[result.id] }}">
        {% if loop.first and not shared %}{{ costs.not_applicable }}
        {% elif amount is none %}<span data-provenance="unknown">{{ costs.not_provided }}</span>
        {% elif amount is integer %}{{ format.integer(amount) }}
        {% elif quantity %}{{ format.number(amount) }}
        {% else %}{{ format.money(amount, cost_currency) }}{% endif %}
      </td>
    {% endfor %}
  </tr>
{%- endmacro %}
{% macro cost_heading(text) -%}
  <th scope="row" role="rowheader" data-label="{{ costs.category }}">
    {{ text }}
  </th>
{%- endmacro %}
{% macro cost_origin() -%}
  <p class="note-text cost-origin" data-cost-origin="{{ calculation_origin }}">{{ costs.origins[calculation_origin] }}</p>
{%- endmacro %}
{% macro cost_amount(amount, whole=false) -%}
  {{ strings.status.unknown if amount is none else format.money(amount, cost_currency, whole=whole) }}
{%- endmacro %}
{% macro missing_cost_link(count) -%}
  {% set text = costs.inputs_missing_one if count == 1 else costs.inputs_missing %}
  <a class="more symbol-label symbol-wrap" href="#costs-missing"><span class="symbol-text">{{ text.format(n=format.integer(count)) }}</span>{{ icon('chevron-right') }}</a>
{%- endmacro %}
{% macro cost_comparison(comparison, whole=false) -%}
  <span>
    {% if comparison.direction in ('less', 'more') %}
      <span class="cost-value">{{ cost_amount(comparison.amount, whole=whole and comparison.amount * 2 >= 1) }}</span>
    {% endif %}
    {{ costs[comparison.direction] }}
  </span>
{%- endmacro %}
{% macro cost_notes() -%}
  <div class="cost-notes">
    <p class="note-text">{{ costs.stay_assumption }}</p>
    {% for tile in cost_tiles if tile.break_even is not none %}
      {% set scenario = tile.result.id %}
      {% set threshold = tile.break_even %}
      <p class="note-text" data-break-even="{{ scenario }}">{{
        costs.break_even_none.format(scenario=costs[scenario]) if threshold.amount < 0 else
        costs.break_even.format(scenario=costs[scenario], amount=cost_amount(threshold.amount, whole=true), entered=cost_amount(threshold.entered, whole=true))
      }}</p>
    {% endfor %}
  </div>
{%- endmacro %}
{% macro cost_chart() -%}
  <div class="cost-bars">
    <ul class="legend" role="list">
      {% for block in cost_blocks %}
        <li class="symbol-label symbol-wrap"><span class="cost-swatch cost-{{ block.id }} symbol" aria-hidden="true"></span><span class="symbol-text">{{ costs.groups[block.id] }}</span></li>
      {% endfor %}
    </ul>
    {% for row in cost_chart_rows %}
      {% set result = row.tile.result %}
      <div class="cost-chart-row" data-chart-scenario="{{ result.id }}">
        <div class="cost-chart-heading">
          <h3>{{ costs[result.id] }}</h3>
          {% if row.share is none %}
            <p>{{ costs.total_unknown }}</p>
          {% else %}
            <p>
              <strong class="cost-value">{{ cost_amount(result.total) }}</strong>
              {% if result.id != 'stay' %}
                · {% if row.tile.comparison.direction == 'unknown' %}
                  {{ costs.difference }} · {{ status_label('unknown') }}
                {% else %}{{ cost_comparison(row.tile.comparison) }}{% endif %}
              {% endif %}
            </p>
          {% endif %}
        </div>
        {% if row.share is none %}
          <span class="cost-segment is-unknown symbol-label" aria-hidden="true">{{ icon('help') }}</span>
          {% if row.tile.known_blocks is not none %}
            <p class="cost-known-blocks">{{ costs.known_blocks.format(amount=cost_amount(row.tile.known_blocks)) }}</p>
            <ul class="cost-chart-values" role="list">
              {% for block in row.blocks if block.total is none %}
                <li>{{ costs.groups[block.id] }} · <span data-chart-value="{{ block.id }}">{{ status_label('unknown') }}</span></li>
              {% endfor %}
            </ul>
          {% endif %}
        {% else %}
          <div class="cost-bar" aria-hidden="true" style="--share: {{ row.share }}">
            {% for block in row.blocks if block.total %}
              <span class="cost-segment cost-{{ block.id }}" data-chart-block="{{ block.id }}" style="flex-grow: {{ plain_amount(block.total) }}"></span>
            {% endfor %}
          </div>
          <ul class="cost-chart-values" role="list">
            {% for block in row.blocks %}
              <li><span>{{ costs.groups[block.id] }}</span> <span class="cost-value" data-chart-value="{{ block.id }}">{{ cost_amount(block.total) }}</span></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{%- endmacro %}
{% macro category_option(id, text, selected=false) -%}
  <option id="f-category-{{ id }}" value="{{ id }}" class="symbol-label"{{ ' selected' if selected }}>{{ icon('check') }}<span class="symbol-text">{{ text }}</span></option>
{%- endmacro %}
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; font-src data:; base-uri 'none'; form-action 'none'">
  <meta name="color-scheme" content="light dark">
  <title>{{ strings.header.title }}</title>
  <style>
    @font-face {
      font-family: Figtree;
      src: url(data:font/woff2;base64,{{ fonts['figtree-latin'] }}) format("woff2");
      font-weight: 300 900;
      font-display: swap;
    }
    @font-face {
      font-family: "Geist Mono";
      src: url(data:font/woff2;base64,{{ fonts['geist-mono-latin'] }}) format("woff2");
      font-weight: 100 900;
      font-display: swap;
    }
    {# Same tokens as the website. Light: apple.com neutrals. Dark: Fazit's green
       on black. Status: iOS system colours. A test keeps both in step. #}
    :root {
      color-scheme: light;
      --bg: #ffffff;
      --surface: #f5f5f7;
      --fill-2: #e8e8ed;
      --text: #1d1d1f;
      --muted: #6e6e73;
      --line: #d2d2d7;
      --accent: #1d1d1f;
      --accent-hover: #424245;
      --status-ready: #34c759;
      --status-needs-work: #ffcc00;
      --status-blocker: #ff9500;
      --status-unknown: #8e8e93;
      --status-strength: 60%;
      --fs-display: clamp(2.5rem, 5vw, 3.5rem);
      --fs-title: clamp(2rem, 3.6vw, 2.5rem);
      --fs-headline: 1.5rem;
      --fs-lead: 1.3125rem;
      --fs-body: 1.0625rem;
      --fs-subhead: 0.875rem;
      --fs-footnote: 0.75rem;
      --radius-card: 14px;
    }
    @media screen and (prefers-color-scheme: dark) {
      :root {
        color-scheme: dark;
        --bg: #050906;
        --surface: #111712;
        --fill-2: #1a251c;
        --text: #c4f7d0;
        --muted: #7b9d83;
        --line: #1e2820;
        --accent: #c4f7d0;
        --accent-hover: #e1fbe7;
        --status-ready: #30d158;
        --status-needs-work: #ffd60a;
        --status-blocker: #ff9f0a;
        --status-unknown: #8e8e93;
        --status-strength: 100%;
      }
    }
    :root {
      --fg: var(--text);
      --fg-2: var(--muted);
      --rule: var(--line);
      --fill: var(--surface);
      --link: var(--accent);
      --link-hover: var(--accent-hover);
      --link-quiet: var(--accent-hover);
      --solid-bg: var(--text);
      --solid-fg: var(--bg);
      --link-glow: transparent;
      --sans: Figtree, ui-sans-serif, system-ui, sans-serif;
      --mono: "Geist Mono", ui-monospace, monospace;
      --ease: cubic-bezier(0.32, 0.72, 0, 1);
      --gutter: 20px;
      --section-space: 48px;
      --card-padding: 24px;
      --max: 1120px;
      --measure: 42.5rem;
      --bar-h: 52px;
      --hit: 44px;
      --radius: 8px;
      --radius-pill: 999px;
      --segment-shadow: rgb(0 0 0 / 12%);
    }
    @media screen and (prefers-color-scheme: dark) {
      :root {
        --link-glow: rgb(196 247 208 / 45%);
        --link-quiet: #9ec9a8;
      }
    }
    @media (max-width: 600px) {
      :root { --gutter: 16px; --section-space: 32px; }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background: var(--bg);
      color: var(--fg);
      font: 400 var(--fs-body) / 1.47 var(--sans);
      -webkit-font-smoothing: antialiased;
    }
    html {
      scroll-padding-block-start: calc(var(--bar-h) + 16px);
      scrollbar-width: none;
      hyphens: manual;
    }
    code {
      font-family: var(--mono);
      font-size: 0.9em;
      overflow-wrap: break-word;
    }
    time { white-space: nowrap; }
    h1, h2, h3, h4, p { margin: 0; }
    h1, h2, h3, h4, strong, b { font-weight: 600; }
    h1, h2, h3, h4 { text-wrap: balance; }
    h3 { font-size: var(--fs-body); line-height: 1.3; margin-block: 32px 12px; }
    p, li, dt, dd, figcaption, td, summary, small { text-wrap: pretty; }
    a { color: var(--link); text-decoration: none; transition: color 0.2s ease, text-shadow 0.2s ease; }
    a:hover { color: var(--accent-hover); }
    @media screen and (prefers-color-scheme: dark) {
      a:hover { text-shadow: 0 0 12px var(--link-glow); }
    }
    :focus-visible {
      outline: 2px solid var(--link);
      outline-offset: 3px;
    }
    .sr-only, .skip:not(:focus) {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .skip {
      position: fixed;
      z-index: 20;
      inset-block-start: 12px;
      inset-inline-start: 12px;
      padding: 12px 16px;
      border-radius: var(--radius);
      background: var(--solid-bg);
      color: var(--solid-fg);
    }
    .skip:hover { color: var(--solid-fg); text-shadow: none; }
    .bar {
      position: sticky;
      inset-block-start: 0;
      z-index: 10;
      background: color-mix(in srgb, var(--bg) 82%, transparent);
      backdrop-filter: saturate(180%) blur(20px);
    }
    .bar-in {
      position: relative;
      display: flex;
      align-items: center;
      gap: 24px;
