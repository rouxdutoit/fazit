{# SPDX-License-Identifier: AGPL-3.0-or-later #}
{% macro column(text) -%}
  <th scope="col" role="columnheader" data-label="{{ text }}">{{ text }}</th>
{%- endmacro %}
{% macro reason_detail(code) -%}
  {% set reason, fix = reason_text(code) %}
  <span data-reason="{{ code }}">{{ reason }} {{ fix }}</span>
{%- endmacro %}
{% macro finding_date(finding) -%}
  {% if finding.collected_at %}{{ format.date(finding.collected_at) }}
  {%- elif finding.provenance == 'provided' or finding.source in provided_sources %}{{ strings.common.date_not_supplied }}
  {%- else %}{{ strings.common.unavailable }}{% endif %}
{%- endmacro %}
{% macro finding_source(finding) -%}
  {{ code_label('source', finding.source) if finding.source else strings.common.unavailable }}
{%- endmacro %}
{% macro finding_coverage(finding) -%}
  {{ coverage_text(finding.coverage, provided=finding.provenance == 'provided' or finding.source in provided_sources) }}
{%- endmacro %}
{% macro provenance_word(provenance) -%}
  {{ strings.provenance.measured_sample if sample_scan and provenance == 'measured' else strings.provenance[provenance] }}
{%- endmacro %}
{% macro evidence_summary(finding, compact=false) -%}
  <div data-provenance="{{ finding.provenance }}">
    {% if finding.value is not none %}{{ value_text(finding) }}{% endif %}
    {% set provided = finding.provenance == 'provided' %}
    <small class="evidence-meta"><span class="prov">{{ provenance_word(finding.provenance) }}</span>
      {%- if finding.source and (provided or not compact) %} · {{ finding_source(finding) }}{% endif %}
      {%- if provided or (finding.collected_at and not compact) %} · {{ finding_date(finding) }}{% endif %}
      {%- if finding.period and not compact %} · {{ format.period(finding.period) }}{% endif %}
      {%- if finding.coverage and (not compact or finding.coverage.kind != 'complete') %} · {{ finding_coverage(finding) }}{% endif -%}
    </small>
  </div>
{%- endmacro %}
{% macro alternative_evidence(finding, compact=false) -%}
  {% if finding.id in alternatives %}
    {% set alternative = alternatives[finding.id] %}
    <small>{{ strings.found.comparison }}</small>
    {{ evidence_summary(alternative, compact) }}
    {% if alternative.missing_reason %}<small>{{ reason_detail(alternative.missing_reason) }}</small>{% endif %}
    {% if finding.id in conflicts %}
      <small>{{ strings.readiness.conflict if finding.is_lower_bound else strings.reason.confirmation_conflict.label }}</small>
    {% endif %}
    {% if finding.id in answer_conflicts %}<small>{{ strings.reason.provided_answers_conflict.label }}</small>{% endif %}
  {% endif %}
{%- endmacro %}
{% macro evidence_pair(finding) -%}
  {{ evidence_summary(finding) }}
  {{ alternative_evidence(finding) }}
{%- endmacro %}
{% macro finding_table(workload, observations) -%}
  <div class="table-scroll" role="region" aria-labelledby="evidence-{{ workload }}" tabindex="0">
    <table class="coverage" role="table">
      {% if sample_scan %}<caption data-sample>{{ strings.found.sample }}</caption>{% endif %}
      <thead role="rowgroup">
        <tr role="row">
          {{ column(strings.found.finding) }}
          {{ column(strings.found.value) }}
        </tr>
      </thead>
      <tbody role="rowgroup">
        {% for entry, finding in observations %}
          <tr data-finding="{{ finding.id }}" data-provenance="{{ finding.provenance }}" role="row">
            <th scope="row" role="rowheader" data-label="{{ strings.found.finding }}">{{ label(entry.label) }}</th>
            <td role="cell" data-label="{{ strings.found.value }}">
              {{ evidence_pair(finding) }}
              {% if finding.collector %}
                <small>{{ strings.found.collector }} · {{ code_label('collector', finding.collector) }}</small>
              {% endif %}
              {% if finding.missing_reason %}<small>{{ reason_detail(finding.missing_reason) }}</small>{% endif %}
            </td>
          </tr>
        {% endfor %}
        {% set note = strings.found.notes.get(workload) %}
        {% if sample_scan and note %}
          <tr role="row"><td class="table-note" role="cell" colspan="2" data-label="{{ strings.found.note }}">{{ note }}</td></tr>
        {% endif %}
      </tbody>
    </table>
  </div>
{%- endmacro %}
{% macro attention_evidence(finding) -%}
  {% if finding %}
    {{ evidence_pair(finding) }}
    {% if finding.missing_reason %}
      <small>{{ reason_detail(finding.missing_reason) }}</small>
    {% elif finding.provenance == 'provided' and finding.coverage and finding.coverage.kind == 'partial' %}
      <small>{{ reason_detail('answer_not_provided') }}</small>
    {% endif %}
  {% else %}
    <div data-provenance="unknown">
      <span class="prov">{{ strings.provenance.unknown }}</span>
      <small>{{ reason_detail('answer_not_provided') }}</small>
    </div>
  {% endif %}
{%- endmacro %}
{% macro missing_answer() -%}
  <span data-provenance="unknown">
    {{ strings.common.not_stated }}
    <small>{{ reason_detail('answer_not_provided') }}</small>
  </span>
{%- endmacro %}
{% macro icon(name) -%}
  <svg class="icon" viewBox="0 -960 960 960" aria-hidden="true" focusable="false"><path d="{{ icons[name] }}"/></svg>
{%- endmacro %}
{% macro status_label(status) -%}
  <span class="status {{ status }}">{{ icon({'ready': 'check-circle', 'needs_work': 'warning', 'blocker': 'report', 'unknown': 'help'}[status]) }} {{ strings.status[status] }}</span>
{%- endmacro %}
{% macro workload_status(row) -%}
  {{ status_label(row.status) }}
  {% if row.incomplete %}<small class="note-text">{{ strings.readiness.incomplete }}</small>{% endif %}
{%- endmacro %}
{% macro status_reason(row) -%}
  {% if row.deciding %}{{ row.deciding.reason[lang] }}
  {% elif row.reason_code %}{{ reason_detail(row.reason_code) }}
  {% else %}{{ status_rules.workloads[row.workload].ready_reason[lang] }}{% endif %}
{%- endmacro %}
{% macro mapping_date(row) -%}
  {% if row.checked_on %}
    {% set day = row.checked_on.isoformat() %}
    <time datetime="{{ day }}">{{ format.date(day) }}</time>
  {% else %}{{ strings.moves.no_project_check }}{% endif %}
{%- endmacro %}
{% macro mapping_review() -%}
  {% if mapping.reviewed_on %}
    {% set day = mapping.reviewed_on.isoformat() %}
    <p data-mapping-review="{{ day }}">{{ strings.moves.reviewed.format(date=format.date(day)) }}</p>
  {% else -%}
    <p data-mapping-review="unreviewed">{{ strings.moves.unreviewed }}</p>
  {% endif %}
{%- endmacro %}
{% macro conditions_list(conditions) -%}
  <ul>
    {% for condition in conditions %}
      <li>
        {{ finding_labels[condition.finding] }}
        {% if condition.op == 'exists' %}{{ strings.appendix.condition_exists }}
        {% else %}{{ condition.op }} {{ literal_text(condition.value) }}{% endif %}
        {% if condition.provenance %}<span class="prov">{{ strings.provenance[condition.provenance] }}</span>{% endif %}
      </li>
    {% endfor %}
  </ul>
{%- endmacro %}
{% set costs = strings.costs %}
{% set prices_invented = inputs and inputs.amounts_are_invented %}
{% set calculation_origin = 'calculated_with_examples' if prices_invented else 'calculated' %}
{% macro cost_columns(label) -%}
  <thead role="rowgroup">
    <tr role="row">
      {{ column(label) }}
      {% for result in scenarios %}{{ column(costs[result.id]) }}{% endfor %}
    </tr>
  </thead>
{%- endmacro %}
{% macro cost_caption() -%}
  {% if prices_invented %}<caption data-invented-amounts>{{ costs.invented_amounts }}</caption>{% endif %}
{%- endmacro %}
{% macro cost_input_row(field, amounts, shared=false) -%}
  {% set quantity = field in ('users', 'training_staff', 'training_days_per_person', 'parallel_running_months') %}
  <tr data-cost-input="{{ field }}" role="row">
    <th scope="row" role="rowheader" data-label="{{ costs.input }}">
      {{ costs.input_fields[field] }}
      {% if amounts|reject('none')|list %}
        {% set origin = 'invented' if prices_invented and not quantity else ('sample_input' if sample_inputs and quantity else 'provided') %}
        <small data-cost-origin="{{ origin }}">{{ costs.origins[origin] }}</small>
      {% endif %}
    </th>
    {% for result in scenarios %}
      {% set amount = amounts[loop.index0] %}
      <td role="cell" data-label="{{ costs[result.id] }}">
        {% if loop.first and not shared %}{{ costs.not_applicable }}
        {% elif amount is none %}<span data-provenance="unknown">{{ costs.not_provided }}</span>
        {% elif amount is integer %}{{ format.integer(amount) }}
        {% elif quantity %}{{ format.number(amount) }}
        {% else %}{{ format.money(amount, cost_currency) }}{% endif %}
      </td>
    {% endfor %}
  </tr>
{%- endmacro %}
{% macro cost_heading(text, known) -%}
  <th scope="row" role="rowheader" data-label="{{ costs.category }}">
    {{ text }}
    {% if known %}
      <small data-cost-origin="{{ calculation_origin }}">{{ costs.origins[calculation_origin] }}</small>
    {% endif %}
  </th>
{%- endmacro %}
{% macro cost_amount(amount, whole=false) -%}
  {{ strings.status.unknown if amount is none else format.money(amount, cost_currency, whole=whole) }}
{%- endmacro %}
{% macro missing_cost_link(count) -%}
  {% set text = costs.inputs_missing_one if count == 1 else costs.inputs_missing %}
  <a class="more" href="#costs-missing">{{ text.format(n=format.integer(count)) }}{{ icon('chevron-right') }}</a>
{%- endmacro %}
{% macro cost_comparison(comparison, whole=false) -%}
  <span>
    {% if comparison.direction in ('less', 'more') %}
      <span class="cost-value">{{ cost_amount(comparison.amount, whole=whole and comparison.amount * 2 >= 1) }}</span>
    {% endif %}
    {{ costs[comparison.direction] }}
  </span>
{%- endmacro %}
{% macro cost_notes() -%}
  <div class="cost-notes">
    <p class="note-text">{{ costs.stay_assumption }}</p>
    {% for tile in cost_tiles if tile.break_even is not none %}
      {% set scenario = tile.result.id %}
      {% set threshold = tile.break_even %}
      <p class="note-text" data-break-even="{{ scenario }}">{{
        costs.break_even_none.format(scenario=costs[scenario]) if threshold.none else
        costs.break_even.format(scenario=costs[scenario], amount=cost_amount(threshold.amount, whole=true), entered=cost_amount(threshold.entered, whole=true))
      }}</p>
    {% endfor %}
  </div>
{%- endmacro %}
{% macro cost_chart() -%}
  <div class="cost-bars">
    <ul class="legend" role="list">
      {% for block in cost_blocks %}
        <li><span class="cost-swatch cost-{{ block.id }}" aria-hidden="true"></span>{{ costs.groups[block.id] }}</li>
      {% endfor %}
    </ul>
    {% for row in cost_chart_rows %}
      {% set result = row.tile.result %}
      <div class="cost-chart-row" data-chart-scenario="{{ result.id }}">
        <div class="cost-chart-heading">
          <h3>{{ costs[result.id] }}</h3>
          {% if row.share is none %}
            <p>{{ costs.total_unknown }}</p>
          {% else %}
            <p>
              <strong class="cost-value">{{ cost_amount(result.total) }}</strong>
              {% if result.id != 'stay' %}
                · {% if row.tile.comparison.direction == 'unknown' %}
                  {{ costs.difference }} · {{ status_label('unknown') }}
                {% else %}{{ cost_comparison(row.tile.comparison) }}{% endif %}
              {% endif %}
              <small data-cost-origin="{{ calculation_origin }}">{{ costs.origins[calculation_origin] }}</small>
            </p>
          {% endif %}
        </div>
        {% if row.share is none %}
          <span class="cost-segment is-unknown" aria-hidden="true">{{ icon('help') }}</span>
          {% if row.tile.known_blocks is not none %}
            <p class="cost-known-blocks">{{ costs.known_blocks.format(amount=cost_amount(row.tile.known_blocks)) }}</p>
            <ul class="cost-chart-values" role="list">
              {% for block in row.unknown_blocks %}
                <li>{{ costs.groups[block] }} · <span data-chart-value="{{ block }}">{{ status_label('unknown') }}</span></li>
              {% endfor %}
            </ul>
          {% endif %}
        {% else %}
          <div class="cost-bar" aria-hidden="true" style="--share: {{ row.share }}">
            {% for block in row.blocks if block.total %}
              <span class="cost-segment cost-{{ block.id }}" data-chart-block="{{ block.id }}" style="flex-grow: {{ plain_amount(block.total) }}"></span>
            {% endfor %}
          </div>
          <ul class="cost-chart-values" role="list">
            {% for block in row.blocks %}
              <li>{{ costs.groups[block.id] }} · <span class="cost-value" data-chart-value="{{ block.id }}">{{ cost_amount(block.total) }}</span></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{%- endmacro %}
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; font-src data:; base-uri 'none'; form-action 'none'">
  <meta name="color-scheme" content="light dark">
  <title>{{ strings.header.title }}</title>
  <style>
    @font-face {
      font-family: Figtree;
      src: url(data:font/woff2;base64,{{ fonts['figtree-latin'] }}) format("woff2");
      font-weight: 300 900;
      font-display: swap;
    }
    @font-face {
      font-family: "Geist Mono";
      src: url(data:font/woff2;base64,{{ fonts['geist-mono-latin'] }}) format("woff2");
      font-weight: 100 900;
      font-display: swap;
    }
    {# Same tokens as the website. Light: apple.com neutrals and link blue. Dark: Fazit's green
       on black. Status: iOS system colours. A test keeps both in step. #}
    :root {
      color-scheme: light;
      --bg: #ffffff;
      --surface: #f5f5f7;
      --fill-2: #e8e8ed;
      --text: #1d1d1f;
      --muted: #6e6e73;
      --line: #d2d2d7;
      --accent: #1d1d1f;
      --accent-hover: #424245;
      --status-ready: #34c759;
      --status-needs-work: #ffcc00;
      --status-blocker: #ff9500;
      --status-unknown: #8e8e93;
      --fs-display: clamp(2.5rem, 5vw, 3.5rem);
      --fs-title: clamp(2rem, 3.6vw, 2.5rem);
      --fs-headline: 1.5rem;
      --fs-lead: 1.3125rem;
      --fs-body: 1.0625rem;
      --fs-subhead: 0.875rem;
      --fs-footnote: 0.75rem;
      --radius-card: 14px;
    }
    @media screen and (prefers-color-scheme: dark) {
      :root {
        color-scheme: dark;
        --bg: #050906;
        --surface: #111712;
        --fill-2: #1a251c;
        --text: #c4f7d0;
        --muted: #7b9d83;
        --line: #1e2820;
        --accent: #c4f7d0;
        --accent-hover: #e1fbe7;
        --status-ready: #30d158;
        --status-needs-work: #ffd60a;
        --status-blocker: #ff9f0a;
        --status-unknown: #8e8e93;
      }
    }
    :root {
      --fg: var(--text);
      --fg-2: var(--muted);
      --rule: var(--line);
      --fill: var(--surface);
      --link: var(--accent);
      --link-hover: var(--accent-hover);
      --link-quiet: var(--accent-hover);
      --solid-bg: var(--text);
      --solid-fg: var(--bg);
      --link-glow: transparent;
      --sans: Figtree, ui-sans-serif, system-ui, sans-serif;
      --mono: "Geist Mono", ui-monospace, monospace;
      --ease: cubic-bezier(0.32, 0.72, 0, 1);
      --gutter: 20px;
      --max: 1120px;
      --measure: 42.5rem;
      --bar-h: 52px;
      --hit: 44px;
      --radius: 8px;
      --radius-pill: 999px;
      --segment-shadow: rgb(0 0 0 / 12%);
    }
    @media screen and (prefers-color-scheme: dark) {
      :root {
        --link-glow: rgb(196 247 208 / 45%);
        --link-quiet: #9ec9a8;
      }
    }
    @media (max-width: 600px) {
      :root { --gutter: 16px; }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background: var(--bg);
      color: var(--fg);
      font: 400 var(--fs-body) / 1.47 var(--sans);
      -webkit-font-smoothing: antialiased;
    }
    code {
      font: 400 0.875em / 1.5 var(--mono);
      overflow-wrap: anywhere;
    }
    h1, h2, h3, h4, p { margin: 0; }
    h3, h4 { font-weight: 600; text-wrap: balance; }
    h3 { font-size: var(--fs-body); line-height: 1.3; margin-block: 32px 8px; }
    p, li, dd, td { text-wrap: pretty; }
    a { color: var(--link); text-decoration: none; transition: color 0.2s ease, text-shadow 0.2s ease; }
    a:hover { color: var(--accent-hover); }
    main :where(p, li, dt, dd, td) > a:not([class]) {
      text-decoration: underline 1px var(--fg-2);
      text-underline-offset: 0.2em;
    }
    @media screen and (prefers-color-scheme: dark) {
      a:hover { text-shadow: 0 0 12px var(--link-glow); }
    }
    :focus-visible {
      outline: 2px solid var(--link);
      outline-offset: 3px;
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .page-intro {
      max-width: var(--max);
      margin-inline: auto;
      padding: clamp(48px, 7vw, 96px) var(--gutter) clamp(48px, 6vw, 64px);
    }
    .page-intro h1 {
      font-size: var(--fs-display);
      line-height: 1.07;
      font-weight: 600;
      letter-spacing: -0.025em;
      text-wrap: balance;
    }
    .page-intro p {
      max-width: var(--measure);
      margin-top: 12px;
      color: var(--fg-2);
    }
    .page-intro h1 + p { margin-top: 16px; }
    .page-intro time { white-space: nowrap; }
    .grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
      max-width: var(--max);
      margin: 0 auto;
      padding-inline: var(--gutter);
      gap: 16px 48px;
    }
    .sec {
      position: relative;
      padding-block: clamp(64px, 8vw, 96px);
    }
    .sec::before {
      position: absolute;
      inset: 0 var(--gutter) auto;
      height: 1px;
      background: var(--rule);
      content: "";
    }
    .sec-label {
      font-weight: 600;
      font-size: var(--fs-headline);
      line-height: 1.25;
      text-wrap: balance;
    }
    @media (min-width: 880px) {
      .grid { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
      .sec-label {
        position: sticky;
        inset-block-start: calc(var(--bar-h) + 24px);
        align-self: start;
      }
    }
    .sec-body {
      min-width: 0;
      overflow-wrap: break-word;
    }
    .sec-body > :first-child { margin-top: 0; }
    .sec-body > p, .sec-body .subsection > p { max-width: var(--measure); }
    .sec-body p + p { margin-top: 12px; }
    .sec-intro { color: var(--fg-2); }
    .subsection { margin-top: 48px; }
    .sec-body h3 + p { margin-top: 8px; }
    .status-summary { margin: 12px 0 0; }
    .status-summary > div {
      display: grid;
      align-items: baseline;
      gap: 4px 24px;
    }
    .status-summary > div + div { margin-top: 4px; }
    .status-summary dt { font-size: var(--fs-lead); }
    .status-summary dd {
      margin: 0;
      color: var(--fg-2);
      font-size: var(--fs-footnote);
    }
    @media (min-width: 640px) {
      .status-summary > div { grid-template-columns: auto minmax(0, 1fr); }
    }
    .rows {
      margin: 0;
      padding: 0 24px;
      border-radius: var(--radius-card);
      background: var(--fill);
    }
    @media (max-width: 480px) {
      .rows { padding-inline: 16px; }
    }
    .rows > div {
      display: grid;
      gap: 4px;
      padding-block: 16px;
      overflow-wrap: anywhere;
    }
    .rows > div + div { border-top: 1px solid var(--rule); }
    .rows dt { font-weight: 600; }
    .rows dd { margin: 0; color: var(--fg-2); }
    h3 + .rows, .subsection p + .rows { margin-top: 12px; }
    .subsection p:has(> .more) { margin-top: 24px; }
    .rows dt .note-text { margin-top: 0; font-weight: 400; }
    .tiles {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      margin: 24px 0 0;
      padding: 0;
      list-style: none;
    }
    @media (min-width: 1180px) {
      .tiles-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    .tiles li {
      display: grid;
      align-content: start;
      gap: 4px;
      padding: 24px;
      border-radius: var(--radius-card);
      background: var(--fill);
    }
    .tiles p {
      color: var(--fg-2);
      font-size: var(--fs-subhead);
      line-height: 1.43;
    }
    .tiles .tile-label {
      margin-bottom: 4px;
      font-weight: 600;
    }
    .tiles .tile-title {
      display: grid;
      margin-bottom: 4px;
      color: var(--fg);
      font-size: var(--fs-body);
      font-weight: 600;
      line-height: 1.35;
    }
    .tiles .figure-num {
      color: var(--fg);
      font: 600 var(--fs-headline) / 1.1 var(--sans);
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.03em;
      white-space: nowrap;
      overflow-x: auto;
    }
    .cost-value { white-space: nowrap; }
    .cost-notes { max-width: var(--measure); }
    .report-meta {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
      gap: 16px 24px;
      margin: 24px 0;
    }
    .report-meta div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 2px; }
    .report-meta dt { color: var(--muted); font-size: var(--fs-footnote); }
    .report-meta dd { margin: 0; font-weight: 600; }
    .muted, small { color: var(--muted); }
    small { display: block; font-size: var(--fs-footnote); line-height: 1.33; }
    .page-intro .sample-note {
      margin-top: 16px;
      padding: 16px 20px;
      border-radius: var(--radius-card);
      background: var(--surface);
    }
    .headlines {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
      gap: 12px;
      margin-block: 24px 32px;
      padding: 0;
      list-style: none;
    }
    .headlines li {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding: 20px;
      border-radius: var(--radius-card);
      background: var(--surface);
    }
    .headlines strong { font-size: var(--fs-subhead); font-weight: 600; }
    .figure { font-size: var(--fs-title); font-weight: 600; line-height: 1.1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
    .prov { color: var(--muted); font-size: var(--fs-footnote); font-weight: 600; }
    .table-scroll { overflow-x: auto; margin-block: 16px 24px; }
    table { width: 100%; border-collapse: collapse; font-size: var(--fs-subhead); line-height: 1.43; }
    .collectors { table-layout: fixed; }
    th, td {
      padding: 12px 16px 12px 0;
      border-bottom: 1px solid var(--line);
      text-align: start;
      vertical-align: top;
      hyphens: auto;
    }
    thead th { color: var(--muted); font-size: var(--fs-footnote); font-weight: 600; }
    tbody th { font-weight: 600; }
    .collectors thead th:nth-child(1) { width: 24%; }
    .collectors thead th:nth-child(2) { width: 16%; }
    .collectors thead th:nth-child(4) { width: 18%; }
    th[scope="rowgroup"] { padding-block-start: 24px; color: var(--text); font-size: var(--fs-body); }
    caption { padding-block-end: 8px; color: var(--muted); font-size: var(--fs-footnote); text-align: start; }
    .coverage {
      width: 100%;
      border-collapse: collapse;
      font-size: var(--fs-subhead);
    }
    .coverage th, .coverage td, .cost-table th, .cost-table td {
      padding-block: 16px;
      padding-inline-end: 16px;
      padding-inline-start: 0;
      border-bottom: 1px solid var(--rule);
      text-align: start;
      vertical-align: top;
    }
    .coverage tbody tr:last-child > * { border-bottom: 0; }
    .coverage thead th, .cost-table thead th {
      padding-block: 8px;
      color: var(--fg-2);
      font-size: var(--fs-footnote);
      font-weight: 600;
    }
    .coverage tbody th {
      width: 28%;
      font-weight: 600;
    }
    /* Material Symbols (Apache-2.0), inline so the report needs no other file. */
    .icon { flex: none; width: 1.2em; height: 1.2em; fill: currentColor; }
    .status { display: inline-flex; align-items: center; gap: 6px; color: var(--text); font-weight: 600; }
    .ready { --status-fill: var(--status-ready); }
    .needs_work { --status-fill: var(--status-needs-work); }
    .blocker { --status-fill: var(--status-blocker); }
    .unknown { --status-fill: var(--status-unknown); }
    .status .icon { color: var(--status-fill); }
    .finding {
      margin-top: 24px;
      padding: clamp(24px, 4vw, 32px);
      border-radius: var(--radius-card);
      background: var(--fill);
    }
    .finding-area {
      color: var(--fg-2);
      font-size: var(--fs-subhead);
      font-weight: 600;
    }
    .finding-status {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 4px;
      font-size: var(--fs-title);
      line-height: 1.15;
      font-weight: 600;
      letter-spacing: -0.015em;
    }
    .finding-reason {
      max-width: var(--measure);
      margin-top: 12px;
    }
    .finding-target {
      max-width: var(--measure);
      margin-top: 32px;
      color: var(--fg-2);
      font-size: var(--fs-footnote);
    }
    .finding-target > span { display: block; }
    .more {
      display: inline-flex;
      align-items: center;
      gap: 1px;
      color: var(--link-quiet);
    }
    .more:hover { color: var(--link); }
    .more .icon { width: 1em; height: 1em; }
    .table-note, .note-text {
      margin-top: 16px;
      color: var(--fg-2);
      font-size: var(--fs-footnote);
    }
    .areas .finding-area {
      color: var(--fg);
      font-size: var(--fs-headline);
    }
    .areas .finding-status {
      flex-wrap: wrap;
      font-size: var(--fs-body);
    }
    .areas .finding[data-status="ready"] { padding: 16px 24px; }
    .finding-status .note-text { margin-top: 0; }
    .finding-category {
      color: var(--fg-2);
      font-size: var(--fs-subhead);
      font-weight: 400;
    }
    .finding-next { max-width: 36em; margin-top: 12px; }
    .finding-missing { margin-top: 16px; font-size: var(--fs-subhead); }
    .status-group > h3 { margin-top: 0; }
    .status-group + .status-group { margin-top: 32px; }
    .filters {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      margin-block-end: 32px;
    }
    .filters .note-text { margin: 0; }
    .segmented {
      display: inline-flex;
      flex-wrap: wrap;
      min-inline-size: 0;
      max-inline-size: 100%;
      margin: 0;
      border: 0;
      padding: 2px;
      gap: 2px;
      border-radius: var(--radius-pill);
      background: var(--fill);
    }
    .segmented[data-filter="category"] { border-radius: var(--radius-card); }
    .segmented label {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      min-height: var(--hit);
      padding: 0 16px;
      border-radius: var(--radius-pill);
      color: var(--fg-2);
      font: 600 var(--fs-subhead) / 1 var(--sans);
      cursor: pointer;
      transition: background-color 0.2s var(--ease);
    }
    .segmented .status { color: inherit; gap: 4px; }
    .note {
      padding: 16px 24px;
      border-radius: var(--radius-card);
      background: var(--fill);
    }
    @media (max-width: 480px) {
      .note { padding-inline: 16px; }
    }
    .areas-empty {
      display: none;
      margin-top: 24px;
      color: var(--fg-2);
      text-align: center;
    }
    @supports not selector(:has(*)) {
      .filters { display: none; }
    }
    @media screen {
      @supports selector(:has(*)) {
        .segmented label:has(:checked) {
          background: var(--bg);
          color: var(--fg);
          box-shadow: 0 1px 3px var(--segment-shadow);
        }
        .segmented label:not(:has(:disabled)):hover { color: var(--fg); }
        .segmented label:has(:disabled) { opacity: 0.4; cursor: default; }
        .segmented label:has(:focus-visible) {
          outline: 2px solid var(--link);
          outline-offset: 3px;
        }
        {% for status, count in status_counts %}
          [data-section=readiness]:has(#f-status-{{ status }}:checked) .status-group:not([data-status-group="{{ status }}"], :has(> .finding:target)),
          [data-section=readiness]:has(#f-status-{{ status }}:checked) .finding:not([data-status="{{ status }}"], :target) {
            display: none;
          }
        {% endfor %}
        {% for category in categories %}
          [data-section=readiness]:has([id='f-category-{{ category.id }}']:checked) .finding:not([data-category="{{ category.id }}"], :target),
          [data-section=readiness]:has([id='f-category-{{ category.id }}']:checked) .status-group:not(:has(> .finding[data-category="{{ category.id }}"], > .finding:target)) {
            display: none;
          }
          {% for status, count in status_counts %}
            [data-section=readiness]:has(#f-status-{{ status }}:checked):has([id='f-category-{{ category.id }}']:checked):not(:has(.finding[data-status="{{ status }}"][data-category="{{ category.id }}"], .finding:target)) .areas-empty {
              display: block;
            }
          {% endfor %}
        {% endfor %}
      }
    }
    .licences, .moves { table-layout: fixed; }
    .moves thead th:nth-child(-n+3) { width: 17%; }
    .licences thead th:first-child { width: 29%; }
    .licences thead th:nth-child(2), .licences thead th:nth-child(3) { width: 12%; }
    .licence-plan small { margin-block-end: 4px; }
    .risky-files thead th:first-child { width: 18%; }
    .risky-files thead th:nth-child(2) { width: 16%; }
    .risky-files thead th:nth-child(3) { width: 31%; }
    .finding ul, .rule-details ul { margin: 4px 0; padding-inline-start: 16px; }
    .readiness li + li, .not-examined li + li,
    .mapping-gaps li + li, .path-workloads li + li { margin-block-start: 8px; }
    .finding .rule-evidence {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      margin: 32px 0 0;
      padding: 0;
      list-style: none;
    }
    .finding .rule-evidence > li { margin-block-start: 0; }
    @media screen and (min-width: 640px) {
      .finding .rule-evidence {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 32px;
      }
    }
    .evidence-meta {
      order: 3;
      margin: 8px 0 0;
      color: var(--fg-2);
      font-size: var(--fs-footnote);
      line-height: 1.45;
    }
    .evidence-meta .prov { color: var(--fg); }
    .workload-evidence, .cost-inputs { border-block-end: 1px solid var(--line); }
    .workload-evidence summary, .cost-inputs summary {
      display: flex;
      align-items: center;
      gap: 4px;
      min-height: var(--hit);
      padding-block: 12px;
      color: var(--link);
      cursor: pointer;
      list-style: none;
    }
    summary::-webkit-details-marker { display: none; }
    summary .icon { transition: transform 0.3s var(--ease); }
    details[open] > summary .icon { transform: rotate(90deg); }
    .cost-inputs { margin-block: 24px 16px; }
    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 24px;
      margin: 24px 0 8px;
      padding: 0;
      color: var(--fg-2);
      font-size: var(--fs-subhead);
      list-style: none;
    }
    .cost-bars .legend li { display: flex; gap: 8px; }
    .cost-swatch {
      flex: none;
      width: 12px;
      height: 12px;
      margin-top: calc((1lh - 12px) / 2);
      border-radius: var(--radius-pill);
      background: var(--cost-fill);
    }
    .cost-chart-row { margin-top: 24px; }
    .cost-chart-heading {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 4px 16px;
    }
    .cost-chart-heading h3, .cost-chart-heading h3 + p { margin: 0; }
    .cost-chart-heading small { display: inline-block; margin-inline-start: 8px; }
    .cost-bar {
      display: flex;
      width: calc(var(--share) * (100% - 56px));
      height: 24px;
      gap: 2px;
      margin-top: 8px;
      overflow: hidden;
      border-radius: var(--radius-pill);
    }
    .cost-segment { min-width: 2px; background: var(--cost-fill); }
    .cost-running { --cost-fill: var(--fg); }
    .cost-direct_project { --cost-fill: var(--fg-2); }
    .cost-productivity_loss { --cost-fill: color-mix(in srgb, var(--fg-2) 55%, var(--bg)); }
    .cost-parallel_running { --cost-fill: color-mix(in srgb, var(--fg-2) 25%, var(--bg)); }
    .cost-segment.is-unknown {
      display: grid;
      place-items: center;
      width: 48px;
      height: 24px;
      margin-top: 8px;
      border: 1px dashed var(--fg-2);
      border-radius: var(--radius-pill);
      background: transparent;
      color: var(--fg-2);
    }
    .cost-known-blocks { margin-top: 8px; }
    .cost-chart-values {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 24px;
      margin: 8px 0 0;
      padding: 0;
      color: var(--fg-2);
      font-size: var(--fs-subhead);
      list-style: none;
    }
    .cost-table thead th:first-child { width: 34%; }
    .cost-table td { font-variant-numeric: tabular-nums; white-space: nowrap; }
    .cost-table .subtotals > *, .cost-table .totals > * { background: var(--surface); }
    .cost-table .totals td { font-weight: 600; }
    .run-details dt { font-weight: 600; }
    .run-details dd { margin: 0 0 8px; }
    .rule-details dd, .software-counts dd, .mapping-details dd { margin: 0 0 12px; }
    .rule-details dt, .software-counts dt, .mapping-details dt { font-weight: 600; }
    footer {
      width: calc(100% - 2 * var(--gutter));
      max-width: calc(var(--max) - 2 * var(--gutter));
      margin-inline: auto;
      margin-block-start: 32px;
      padding-block: 16px 48px;
      border-block-start: 1px solid var(--line);
      color: var(--muted);
      font-size: var(--fs-footnote);
    }
    @media (prefers-reduced-motion: reduce) {
      a, summary .icon, .segmented label { transition: none; }
    }
    @media screen and (max-width: 600px) {
      .coverage thead {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
      }
      .coverage tr {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 16px;
        padding-block: 16px;
        border-bottom: 1px solid var(--rule);
      }
      .coverage tbody tr:last-child { border-bottom: 0; }
      .coverage th, .coverage td {
        padding: 0;
        border-bottom: 0;
      }
      .coverage tbody th {
        grid-column: 1 / -1;
        width: auto;
        margin-bottom: 8px;
      }
      .coverage td::before {
        display: block;
        margin-bottom: 2px;
        color: var(--fg-2);
        font-size: var(--fs-footnote);
        font-weight: 600;
        content: attr(data-label);
      }
      .workload-evidence .coverage td { grid-column: 1 / -1; }
    }
    @media screen and (max-width: 40rem) {
      .segmented { border-radius: var(--radius-card); }
      .headlines { grid-template-columns: repeat(auto-fit, minmax(min(9.5rem, 100%), 1fr)); }
      table:not(.cost-table, .coverage), table:not(.cost-table, .coverage) :is(caption, tbody, tr, th, td) { display: block; }
      table:not(.cost-table, .coverage) { font-size: var(--fs-body); }
      table:not(.cost-table, .coverage) thead, .cost-table thead {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      table:not(.cost-table, .coverage) tbody tr {
        margin-block-end: 12px;
        padding: 4px 16px;
        border-radius: var(--radius-card);
        background: var(--surface);
      }
      table:not(.cost-table, .coverage) tbody :is(th, td) { border: 0; padding: 12px 0; }
      table:not(.cost-table, .coverage) tbody td + td, table:not(.cost-table, .coverage) tbody th + td { border-block-start: 1px solid var(--line); }
      table:not(.cost-table, .coverage) td[data-label]::before {
        display: block;
        content: attr(data-label);
        color: var(--muted);
        font-size: var(--fs-footnote);
        font-weight: 600;
      }
      .cost-chart-values { display: grid; }
      .cost-table, .cost-table :is(caption, tbody) { display: block; }
      .cost-table tr {
        display: grid;
        gap: 4px;
        padding-block: 16px;
        border-bottom: 1px solid var(--rule);
      }
      .cost-table :is(th, td) { padding: 0; border-bottom: 0; }
      .cost-table tbody th { margin-bottom: 8px; }
      .cost-table td {
        display: grid;
        grid-template-columns: minmax(0, 1fr) max-content;
        align-items: baseline;
        gap: 8px;
        text-align: end;
      }
      .cost-table td::before {
        content: attr(data-label);
        color: var(--fg-2);
        font-size: var(--fs-footnote);
        font-weight: 600;
        text-align: start;
        white-space: normal;
      }
    }
    @page { margin: 15mm; }
    @media print {
      .filters, .areas-empty { display: none; }
      body {
        display: block;
        margin: 0;
        font-size: 10pt;
        print-color-adjust: exact;
      }
      .page-intro h1 { font-size: 24pt; }
      .page-intro, .sec { padding: 16pt 0; }
      .grid { display: block; }
      .sec-label { position: static; margin-bottom: 8pt; }
      .sec::before { inset-inline: 0; }
      h1, h2, h3, h4 { break-after: avoid; }
      footer { width: 100%; padding-block-end: 0; }
      .headlines { grid-template-columns: repeat(4, 1fr); gap: 6pt; }
      .headlines li { padding: 8pt; }
      .table-scroll { overflow: visible; }
      table { font-size: .9em; }
      thead { break-after: avoid; }
      th, td, .cost-table th, .cost-table td { padding: 4pt 6pt 4pt 0; }
      tr, .headlines li, .mapping-gaps li, .path-workloads li, .cost-chart-row { break-inside: avoid; }
      .cost-bar .cost-segment { border: 0.5pt solid var(--rule); }
      tr:has(> th[scope="rowgroup"]) { break-after: avoid; }
      .workload-evidence summary, .cost-inputs summary { break-after: avoid; }
      summary .icon { display: none; }
      .workload-evidence::details-content, .cost-inputs::details-content {
        content-visibility: visible;
        display: block;
        block-size: auto;
      }
    }
  </style>
</head>
<body>
  <header data-section="header">
    <div class="page-intro">
      <h1>{{ strings.header.title }}</h1>
      <dl class="report-meta">
        <div>
          <dt>{{ strings.header.organisation }}</dt>
          <dd>{{ inputs.organisation_name if inputs and inputs.organisation_name else strings.header.unnamed_organisation }}</dd>
        </div>
        <div data-input-role="scan">
          <dt>{{ strings.header.scan_date }}</dt>
          <dd><time datetime="{{ scan.generated_at }}">{{ format.date(scan.generated_at) }}</time></dd>
        </div>
        <div data-input-role="inputs">
          <dt>{{ strings.header.inputs_date }}</dt>
          <dd>{% if inputs and inputs.as_of %}<time datetime="{{ inputs.as_of }}">{{ format.date(inputs.as_of) }}</time>
            {%- elif inputs %}{{ strings.common.date_not_supplied }}
            {%- else %}{{ strings.costs.not_provided }}{% endif %}</dd>
        </div>
        <div><dt>{{ strings.header.tool_version }}</dt><dd>{{ tool_version }}</dd></div>
        <div><dt>{{ strings.header.target_profile }}</dt><dd>{{ mapping.label[lang] }}</dd></div>
      </dl>
      <p>{{ strings.header.local }}</p>
      <p class="muted">{{ strings.header.offline }}</p>
      {% if sample_scan %}<p class="sample-note">{{ strings.header.sample }}</p>{% endif %}
    </div>
  </header>
  <main>
    <section data-section="summary">
      <div class="sec grid">
        <h2 class="sec-label" id="summary-title">{{ strings.summary.title }}</h2>
        <div class="sec-body">
          <p class="sec-intro">{{ strings.summary.of_areas.format(n=format.integer(area_count)) }}</p>
          <dl class="status-summary">
            {% for status, count in status_counts %}
              <div>
                <dt>{{ status_label(status) }} {{ format.integer(count) }}</dt>
                <dd>{{ strings.summary.define[status] }}</dd>
              </div>
            {% endfor %}
          </dl>
          {% set blockers = summary_rows.blockers %}
          {% set open_areas = summary_rows.open_areas %}
          <div class="subsection" data-summary="blockers">
            <h3>{{ strings.summary.blockers }}</h3>
            {% if blockers %}
              {% set shown = blockers[:3] %}
              {% if blockers|length > shown|length %}
                <p class="note-text">{{ strings.summary.confirmed.format(shown=format.integer(shown|length), total=format.integer(blockers|length)) }}</p>
              {% endif %}
              <dl class="rows">
                {% for row in shown %}
                  <div>
                    <dt><a href="#readiness-{{ row.workload }}">{{ workload_labels[row.workload] }}</a>{% if row.incomplete %}<small class="note-text">{{ strings.readiness.incomplete }}</small>{% endif %}</dt>
                    <dd>{{ status_reason(row) }}</dd>
                  </div>
                {% endfor %}
              </dl>
              <p><a class="more" href="#status-blocker">{{ strings.summary.all_blockers }}{{ icon('chevron-right') }}</a></p>
            {% else %}
              <p>{{ strings.path.empty.blocker }}</p>
              {% if open_areas %}
                {% set caveat = strings.summary.caveat_one if open_areas|length == 1 else strings.summary.caveat %}
                <p class="note-text">{{ caveat.format(n=format.integer(open_areas|length)) }}</p>
              {% endif %}
            {% endif %}
          </div>
          <div class="subsection" data-summary="unknown">
            <h3>{{ strings.summary.unknown }}</h3>
            {% if open_areas %}
              <dl class="rows">
                {% for workload, fix in open_areas[:4] %}
                  <div>
                    <dt><a href="#readiness-{{ workload }}">{{ workload_labels[workload] }}</a></dt>
                    <dd>{{ fix }}</dd>
                  </div>
                {% endfor %}
              </dl>
            {% else %}
              <p>{{ strings.path.empty.unknown }}</p>
            {% endif %}
            <p>
              <a class="more" href="#not-examined">{{ strings.summary.not_examined }}{{ icon('chevron-right') }}</a>
              {% if missing_cost_paths %} · {{ missing_cost_link(missing_cost_paths|length) }}{% endif %}
            </p>
            {% if missing_cost_paths %}<p class="note-text">{{ costs.missing_fix }}</p>{% endif %}
          </div>
          {% if scope_statement %}
            {% set scope = scope_statement %}
            <div class="subsection" data-summary="scope">
              <h3>{{ strings.summary.scope_title.format(profile=scope.profile) }}</h3>
              <p>{{ strings.summary.scope_of.format(n=format.integer(scope.total), profile=scope.profile) }}
                {% for coverage, count in scope.by_coverage %}
                  {{ strings.mapping_coverage[coverage] }} {{ format.integer(count) }}{{ ' · ' if not loop.last }}
                {% endfor %}
              </p>
              {% if scope.needed %}
                <dl class="rows">
                  <div>
                    <dt>{{ strings.summary.scope_needed.format(profile=scope.profile) }}</dt>
                    <dd>{% for name, anchor in scope.needed %}<a href="#{{ anchor }}">{{ name }}</a>{{ ' · ' if not loop.last }}{% endfor %}</dd>
                  </div>
                </dl>
              {% endif %}
              {% if scope.unknown_need %}
                <p>{{ strings.summary.scope_unknown.format(n=format.integer(scope.unknown_need), profile=scope.profile) }}</p>
              {% endif %}
              {% if scope.reviewed_on is none %}<p class="note-text">{{ strings.moves.unreviewed }}</p>{% endif %}
            </div>
          {% endif %}
          <ul class="tiles tiles-3" role="list">
            {% for tile in cost_tiles %}
              {% set result = tile.result %}
              <li data-cost-tile="{{ result.id }}">
                <p class="tile-label">{{ costs.total_label.format(scenario=costs[result.id]) }}</p>
                {% if result.total is none %}
                  <span class="figure-num">{{ status_label('unknown') }}</span>
                  <p class="tile-title">{{
                    costs.known_blocks.format(amount=cost_amount(tile.known_blocks, whole=true)) if tile.known_blocks is not none else
                    (costs.stay_basis if result.id == 'stay' else costs.comparison_unknown)
                  }}</p>
                  <p>{{ missing_cost_link(result.missing_inputs|length) }}</p>
                {% else %}
                  <span class="figure-num">{{ cost_amount(result.total, whole=true) }}</span>
                  {% if result.id == 'stay' %}
                    <p class="tile-title">{{ costs.stay_basis }}</p>
                  {% elif tile.comparison.direction == 'unknown' %}
                    <p class="tile-title" data-comparison="unknown">
                      <span>{{ costs.comparison_unknown }} · {{ missing_cost_link(cost_tiles[0].result.missing_inputs|length) }}</span>
                    </p>
                  {% else %}
                    <p class="tile-title" data-comparison="{{ tile.comparison.direction }}">{{ cost_comparison(tile.comparison, whole=true) }}</p>
                  {% endif %}
                  <p data-cost-origin="{{ calculation_origin }}">{{ costs.origins[calculation_origin] }}</p>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
          {{ cost_notes() }}
        </div>
      </div>
    </section>
    <section data-section="path">
      <div class="sec grid">
        <h2 class="sec-label">{{ strings.path.title }}</h2>
        <div class="sec-body">
          {% for status in ('blocker', 'unknown', 'ready') %}
            <h3>{{ strings.path[status] }}</h3>
            {% set rows = statuses|selectattr('status', 'equalto', status)|list %}
            {% if rows %}
              <ul data-path-status="{{ status }}" class="path-workloads">
                {% for row in rows %}
                  <li data-path-workload="{{ row.workload }}">
                    <strong>{{ workload_labels[row.workload] }}</strong> · {{ status_reason(row) }}
                    {% if row.incomplete %}<small>{{ strings.readiness.incomplete }}</small>{% endif %}
                  </li>
                {% endfor %}
              </ul>
            {% else %}<p>{{ strings.path.empty[status] }}</p>{% endif %}
          {% endfor %}
          <p>{{ strings.path.pilot_evidence }} {{ strings.path.pilot_choice }}</p>
          <h3>{{ strings.path.sequence }}</h3>
          <ol>
            {% for step in strings.path.steps %}<li>{{ step }}</li>{% endfor %}
          </ol>
        </div>
      </div>
    </section>
    <section data-section="readiness">
      <div class="sec grid">
        <h2 class="sec-label" id="readiness-title">{{ strings.readiness.title }}</h2>
        <div class="sec-body">
          <div class="filters">
            <fieldset class="segmented" data-filter="status">
              <legend class="sr-only">{{ strings.filter.status_legend }}</legend>
              <label><input class="sr-only" type="radio" name="f-status" id="f-status-all" checked> {{ strings.filter.all }} · {{ format.integer(area_count) }}</label>
              {% for status, count in status_counts %}
                <label><input class="sr-only" type="radio" name="f-status" id="f-status-{{ status }}"{% if count == 0 %} disabled{% endif %}>{{ status_label(status) }} · {{ format.integer(count) }}</label>
              {% endfor %}
            </fieldset>
            <fieldset class="segmented" data-filter="category">
              <legend class="sr-only">{{ strings.filter.category_legend }}</legend>
              <label><input class="sr-only" type="radio" name="f-category" id="f-category-all" checked> {{ strings.filter.all_categories }}</label>
              {% for category in categories %}
                <label><input class="sr-only" type="radio" name="f-category" id="f-category-{{ category.id }}"> {{ category_labels[category.id] }}</label>
              {% endfor %}
            </fieldset>
            <p class="note-text">{{ strings.filter.search_hint }}</p>
          </div>
          <div class="areas readiness">
            {% for status, rows in status_groups %}
              <div class="status-group" data-status-group="{{ status }}">
                <h3 id="status-{{ status }}">{{ status_label(status) }}</h3>
                {% for row in rows %}
                  {% set category = workload_categories[row.workload] %}
                  <article data-workload="{{ row.workload }}" data-status="{{ row.status }}"{% if row.incomplete %} data-incomplete{% endif %} data-category="{{ category }}" class="finding" id="readiness-{{ row.workload }}" aria-labelledby="area-{{ row.workload }}">
                    <h4 class="finding-area" id="area-{{ row.workload }}">{{ workload_labels[row.workload] }} · <span class="finding-category">{{ category_labels[category] }}</span></h4>
                    <p class="finding-status">{{ workload_status(row) }}</p>
                    {% if row.reason_code %}{% set reason, fix = reason_text(row.reason_code) %}{% endif %}
                    <div class="finding-reason">
                      {% if row.reason_code %}<span data-reason="{{ row.reason_code }}">{{ reason }}</span>
                      {% else %}{{ status_reason(row) }}{% endif %}
                      {% if row.notes %}
                        <ul>
                          {% for rule in row.notes %}<li>{{ rule.reason[lang] }}</li>{% endfor %}
                        </ul>
                      {% endif %}
                    </div>
                    {% if row.status != 'ready' %}
                      <p class="finding-next"><strong>{{ strings.readiness.next_step }}</strong> {{ row.deciding.next_step.text[lang] if row.deciding else fix }}</p>
                    {% endif %}
                    {% if row.status != 'ready' and row.missing %}
                      <div class="finding-missing">
                        <p><strong>{{ strings.readiness.missing }}</strong></p>
                        <ul>
                          {% for gap in row.missing %}
                            <li data-missing="{{ gap.finding_id }}">
                              <strong>{{ finding_labels[gap.finding_id] }}</strong>
                              {% if gap.collector %}<small>{{ code_label('collector', gap.collector) }}</small>{% endif %}
                              {{ reason_detail(gap.reason_code) }}
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                    {% endif %}
                    {% set observations = catalogue_evidence[row.workload] %}
                    {% if observations or row.evidence %}
                      {% set counts = evidence_counts[row.workload] %}
                      <details class="workload-evidence" data-evidence-workload="{{ row.workload }}">
                        <summary id="evidence-{{ row.workload }}">{{ icon('chevron-right') }}{{ strings.readiness.evidence_summary.format(measured=format.integer(counts.measured), provided=format.integer(counts.provided), unknown=format.integer(counts.unknown)) }}</summary>
                        {% if row.evidence %}
                          <ul class="rule-evidence" role="list">
                            {% for finding in row.evidence %}
                              <li data-evidence="{{ finding.id }}">
                                <strong>{{ finding_labels[finding.id] }}</strong>
                                {{ evidence_pair(finding) }}
                                {% if finding.missing_reason %}<small>{{ reason_detail(finding.missing_reason) }}</small>{% endif %}
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}
                        {% if observations %}{{ finding_table(row.workload, observations) }}{% endif %}
                      </details>
                    {% endif %}
                    <p class="finding-target">
                      {% for item in target_functions[row.workload] %}
                        <span data-target-function="{{ item.function }}">{{ item.replacement[lang] }} · {{ strings.mapping_coverage[item.coverage] }} · {{ mapping_date(item) }}</span>
                      {% else %}
                        {{ strings.moves.no_function }}
                      {% endfor %}
                      <a class="more" href="#moves-title">{{ strings.readiness.all_replacements }}{{ icon('chevron-right') }}</a>
                    </p>
                  </article>
                {% endfor %}
              </div>
            {% endfor %}
          </div>
          <p class="areas-empty note">{{ strings.filter.empty }}</p>
          <div data-subsection="not-examined" id="not-examined">
            <h3>{{ strings.readiness.not_examined }}</h3>
            <ul class="not-examined">
              {% for row in statuses if row.reason_code %}
                <li data-unexamined-workload="{{ row.workload }}"><strong>{{ workload_labels[row.workload] }}</strong> · {{ reason_detail(row.reason_code) }}</li>
              {% endfor %}
              {% for finding in unknown_findings %}
                <li data-unexamined-finding="{{ finding.id }}"><strong>{{ finding_labels[finding.id] }}</strong> · {{ reason_detail(finding.missing_reason) }}</li>
              {% endfor %}
              {% for collector in skipped_collectors %}
                <li data-unexamined-collector="{{ collector.id }}"><strong>{{ code_label('collector', collector.id) }}</strong> · {{ reason_detail(collector.reason) }}</li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </section>
    <section data-section="costs">
      <div class="sec grid">
        <h2 class="sec-label">{{ costs.title }}</h2>
        <div class="sec-body">
          <p class="sec-intro">
            {{ inputs.organisation_name if inputs and inputs.organisation_name else strings.header.unnamed_organisation }}
            · {{ strings.header.scan_date }} <time datetime="{{ scan.generated_at }}">{{ format.date(scan.generated_at) }}</time>
            · {{ strings.header.inputs_date }}
            {% if inputs and inputs.as_of %}<time datetime="{{ inputs.as_of }}">{{ format.date(inputs.as_of) }}</time>
            {% elif inputs %}{{ strings.common.date_not_supplied }}
            {% else %}{{ costs.not_provided }}{% endif %}
            · {{ costs.origins['invented' if prices_invented else 'provided'] if inputs else costs.not_provided }}
          </p>
          <p class="note-text">{{ costs.profile_note }}</p>
          {% if cost_chart_rows %}{{ cost_chart() }}
          {% else %}<p class="note">{{ costs.provide_inputs }}</p>{% endif %}
          {{ cost_notes() }}
          <h3 id="cost-results-title">{{ costs.results }}</h3>
          <div class="table-scroll" role="region" aria-labelledby="cost-results-title" tabindex="0">
            <table class="cost-table" role="table">
              {{ cost_caption() }}
              {{ cost_columns(costs.category) }}
              {% for block in cost_blocks %}
                <tbody data-block="{{ block.id }}" role="rowgroup">
                  <tr role="row">
                    <th scope="rowgroup" role="rowheader" colspan="{{ scenarios|length + 1 }}" data-label="{{ costs.category }}">{{ costs.groups[block.id] }}</th>
                  </tr>
                  {% for id, lines in block.lines %}
                    <tr role="row" data-cost-line="{{ id }}">
                      {{ cost_heading(costs.line_items[id], lines|reject('none')|rejectattr('amount', 'none')|list) }}
                      {% for line in lines %}
                        {% set result = scenarios[loop.index0] %}
                        <td role="cell" data-label="{{ costs[result.id] }}"{% if line %} data-amount="{{ plain_amount(line.amount) }}"{% endif %}>
                          {{ cost_amount(line.amount) if line else costs.not_applicable }}
                        </td>
                      {% endfor %}
                    </tr>
                  {% endfor %}
                  <tr class="subtotals" role="row">
                    {{ cost_heading(costs.subtotal, block.groups|rejectattr('total', 'none')|list) }}
                    {% for group in block.groups %}
                      <td role="cell" data-label="{{ costs[scenarios[loop.index0].id] }}" data-amount="{{ plain_amount(group.total) }}">{{ cost_amount(group.total) }}</td>
                    {% endfor %}
                  </tr>
                </tbody>
              {% endfor %}
              <tbody role="rowgroup">
                <tr class="totals" role="row">
                  {{ cost_heading(costs.total, scenarios|rejectattr('total', 'none')|list) }}
                  {% for result in scenarios %}
                    <td data-scenario="{{ result.id }}" data-total="{{ plain_amount(result.total) }}" role="cell" data-label="{{ costs[result.id] }}">{{ cost_amount(result.total) }}</td>
                  {% endfor %}
                </tr>
                <tr role="row">
                  {{ cost_heading(costs.difference, scenarios|rejectattr('difference_to_stay', 'none')|list) }}
                  {% for result in scenarios %}
                    <td role="cell" data-label="{{ costs[result.id] }}">{{ cost_amount(result.difference_to_stay) }}</td>
                  {% endfor %}
                </tr>
              </tbody>
            </table>
          </div>
          <p class="muted">{{ costs.rounding }}</p>
          <p class="note-text">{{ costs.vat_note }}</p>
          {% if missing_cost_paths %}
            <div id="costs-missing">
              {% for result in scenarios if result.missing_inputs %}
                <h3>{{ costs.missing.format(scenario=costs[result.id]) }}</h3>
                <ul>
                  {% for path in result.missing_inputs %}
                    <li data-missing-cost="{{ path }}">{{ costs.input_fields[path.split('.')[-1]] }}</li>
                  {% endfor %}
                </ul>
              {% endfor %}
              <p>{{ costs.missing_fix }}</p>
            </div>
          {% endif %}
          <details class="cost-inputs">
            <summary id="cost-inputs-title">{{ icon('chevron-right') }}{{ costs.inputs }}</summary>
            <div class="table-scroll" role="region" aria-labelledby="cost-inputs-title" tabindex="0">
              <table class="cost-table" role="table">
                {{ cost_caption() }}
                {{ cost_columns(costs.input) }}
                <tbody role="rowgroup">
                  {% for field, amount in current_costs.items() %}
                    {{ cost_input_row(field, [amount] * (scenarios|length), shared=true) }}
                  {% endfor %}
                  {% for field in target_costs[0] %}
                    {{ cost_input_row(field, (none, target_costs[0][field], target_costs[1][field])) }}
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </details>
        </div>
      </div>
    </section>
    <section data-section="moves">
      <div class="sec grid">
        <h2 class="sec-label" id="moves-title">{{ strings.moves.title }}</h2>
        <div class="sec-body">
          {{ mapping_review() }}
          <div class="table-scroll" role="region" aria-labelledby="moves-title" tabindex="0">
            <table class="moves" role="table">
              {% if sample_scan %}<caption data-sample>{{ strings.found.sample }}</caption>{% endif %}
              <thead role="rowgroup">
                <tr role="row">
                  {{ column(strings.moves.microsoft) }}
                  {{ column(strings.moves.replacement) }}
                  {{ column(strings.moves.coverage) }}
                  {{ column(strings.moves.evidence) }}
                  {{ column(strings.moves.workload_status) }}
                </tr>
              </thead>
              <tbody role="rowgroup">
                {% for item in mapping.functions %}
                  {% set row = status_by_workload[item.workload] %}
                  <tr data-function="{{ item.function }}" data-workload="{{ item.workload }}" data-status="{{ row.status }}" role="row">
                    <th scope="row" role="rowheader" data-label="{{ strings.moves.microsoft }}">{{ item.microsoft[lang] }}</th>
                    <td role="cell" data-label="{{ strings.moves.replacement }}">{{ item.replacement[lang] }}</td>
                    <td role="cell" data-label="{{ strings.moves.coverage }}">
                      {{ strings.mapping_coverage[item.coverage] }}
                      <small>{{ mapping_date(item) }}</small>
                    </td>
                    <td role="cell" data-label="{{ strings.moves.evidence }}">
                      <a href="#readiness-{{ item.workload }}">{{ strings.moves.workload_evidence.format(workload=workload_labels[item.workload]) }}</a>
                    </td>
                    <td role="cell" data-label="{{ strings.moves.workload_status }}">
                      {{ workload_status(row) }}
                      <div>{{ status_reason(row) }}</div>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% for workload in mapping.no_function %}
            <p><strong>{{ workload_labels[workload] }}</strong> · {{ strings.moves.no_function }}</p>
          {% endfor %}
        </div>
      </div>
    </section>
    <section data-section="attention">
      <div class="sec grid">
        <h2 class="sec-label">{{ strings.attention.title }}</h2>
        <div class="sec-body">
          <h3 id="risky-files-title">{{ strings.attention.files }}</h3>
          <div class="table-scroll" role="region" aria-labelledby="risky-files-title" tabindex="0">
            <table class="risky-files" role="table">
              {% if sample_scan %}<caption data-sample>{{ strings.found.sample }}</caption>{% endif %}
              <thead role="rowgroup">
                <tr role="row">
                  {{ column(strings.attention.file_kind) }}
                  {{ column(strings.attention.extensions) }}
                  {{ column(strings.attention.count) }}
                  {{ column(strings.found.note) }}
                </tr>
              </thead>
              <tbody role="rowgroup">
                {% for kind, finding in risky_files %}
                  <tr data-kind="{{ kind.id }}" role="row">
                    <th scope="row" role="rowheader" data-label="{{ strings.attention.file_kind }}">{{ kind.label[lang] }}</th>
                    <td role="cell" data-label="{{ strings.attention.extensions }}">
                      {% for extension in kind.extensions %}<code>.{{ extension }}</code>{{ ', ' if not loop.last }}{% endfor %}
                    </td>
                    <td role="cell" data-label="{{ strings.attention.count }}">
                      {{ attention_evidence(finding) }}
                      {% if finding and finding.value == 0 and finding.id not in conflicts and finding.id not in answer_conflicts and (not finding.coverage or finding.coverage.kind == 'complete') %}
                        <small>{{ strings.attention.none_reported }}</small>
                      {% endif %}
                    </td>
                    <td role="cell" data-label="{{ strings.found.note }}">{{ kind.note[lang] }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          <h3 id="software-title">{{ strings.attention.software }}</h3>
          <dl class="software-counts">
            {% for entry, finding in software %}
              <dt>{{ label(entry.label) }}</dt>
              <dd data-software-count="{{ entry.id }}">{{ attention_evidence(finding) }}</dd>
            {% endfor %}
          </dl>
          {% if inputs and inputs.windows_only_software %}
            <div class="table-scroll" role="region" aria-labelledby="software-title" tabindex="0">
              <table role="table">
                <thead role="rowgroup">
                  <tr role="row">
                    {{ column(strings.attention.software_name) }}
                    {{ column(strings.attention.software_users) }}
                    {{ column(strings.attention.software_web_version) }}
                  </tr>
                </thead>
                <tbody role="rowgroup">
                  {% for item in inputs.windows_only_software %}
                    <tr data-software-entry data-provenance="provided" role="row">
                      <th scope="row" role="rowheader" data-label="{{ strings.attention.software_name }}">
                        {{ item.name }} <span class="prov">{{ strings.provenance.provided }}</span>
                        <small>{{ code_label('source', input_source) }} · {{ format.date(inputs.as_of) if inputs.as_of else strings.common.date_not_supplied }}</small>
                      </th>
                      <td role="cell" data-label="{{ strings.attention.software_users }}">
                        {% if item.users is none %}{{ missing_answer() }}{% else %}<span>{{ format.integer(item.users) }}</span>{% endif %}
                      </td>
                      <td role="cell" data-label="{{ strings.attention.software_web_version }}">
                        {% if item.vendor_has_web_version is none %}{{ missing_answer() }}{% else %}<span>{{ literal_text(item.vendor_has_web_version) }}</span>{% endif %}
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% endif %}
          <div data-subsection="cannot-be-moved">
            <h3>{{ strings.attention.cannot_be_moved }}</h3>
            {% if mapping_gaps %}
              <p>{{ strings.attention.gap_scope }}</p>
              <ul class="mapping-gaps">
                {% for item, finding, need, reasons in mapping_gaps %}
                  <li data-gap="{{ item.function }}" data-need="{{ need }}">
                    <strong id="transfer-gap-{{ item.function }}">{{ item.microsoft[lang] }}</strong>
                    <p>{{ item.note[lang] if item.note else strings.mapping_coverage[item.coverage] }}</p>
                    <p data-provenance="{{ 'unknown' if need == 'unknown' else finding.provenance }}">
                      <strong>{{ strings.attention.needed_here }}</strong> · {{ strings.status.unknown if need == 'unknown' else strings.common[need] }}
                      {% if need == 'unknown' %}
                        {% for reason in reasons %}<small>{{ reason_detail(reason) }}</small>{% endfor %}
                      {% else %}
                        <small>
                          {{ finding_labels[finding.id] }} · <span class="prov">{{ provenance_word(finding.provenance) }}</span>
                          · {{ finding_source(finding) }} · {{ finding_date(finding) }}
                        </small>
                      {% endif %}
                    </p>
                    <small>{{ strings.appendix.mapping_reference }} · {{ item.reference_url or strings.common.unavailable }}</small>
                    <small>{{ strings.appendix.mapping_date }} · {{ mapping_date(item) }}</small>
                  </li>
                {% endfor %}
              </ul>
            {% else %}<p>{{ strings.attention.no_gaps }}</p>{% endif %}
          </div>
        </div>
      </div>
    </section>
    <section data-section="found">
      <div class="sec grid">
        <h2 class="sec-label">{{ strings.found.title_sample if sample_scan else strings.found.title }}</h2>
        <div class="sec-body">
          <ul class="headlines" role="list">
            {% for entry, finding in headlines %}
              {% set provenance = finding.provenance if finding else 'unknown' %}
              <li data-provenance="{{ provenance }}">
                <strong>{{ label(entry.label) }}</strong>
                {% if finding and finding.value is not none %}<span class="figure">{{ value_text(finding) }}</span>{% endif %}
                <span class="prov">{{ provenance_word(provenance) }}</span>
                {% if provenance == 'unknown' %}
                  {% set code = finding.missing_reason if finding else ('not_in_scan' if entry.provided == 'no' else 'answer_not_provided') %}
                  {% set reason, fix = reason_text(code) %}
                  <small data-reason="{{ code }}">{{ reason }} {{ fix }}</small>
                {% elif provenance == 'provided' %}
                  <small>{{ finding_source(finding) }} · {{ finding_date(finding) }}</small>
                {% endif %}
                {% if finding %}{{ alternative_evidence(finding, compact=true) }}{% endif %}
              </li>
            {% endfor %}
          </ul>
          <h3 id="licences-title">{{ strings.licences.title }}</h3>
          {% if product_count %}
            {% set licence_provenance = provenance_word(product_count.provenance) %}
            <p data-provenance="{{ product_count.provenance }}">
              {% if product_count.value is not none %}{{ strings.licences.product_count.format(count=format.integer(product_count.value)) }}{% endif %}
              <span class="prov">{{ licence_provenance }}</span>
              {% if product_count.missing_reason %}
                <small>{{ reason_detail(product_count.missing_reason) }}</small>
              {% elif product_count.coverage.kind in ('partial', 'unknown') %}
                <small>{{ reason_detail('coverage_' ~ product_count.coverage.kind) }}</small>
              {% endif %}
              <small>{{ code_label('source', product_count.source) }} · {{ format.date(product_count.collected_at) }} · {{ coverage_text(product_count.coverage) }}</small>
            </p>
            {% if licence_plan_list_incomplete %}
              <p>{{ reason_detail('licence_plan_list_incomplete') }}</p>
            {% endif %}
            {% if licences %}
              <div class="table-scroll" role="region" aria-labelledby="licences-title" tabindex="0">
                <table class="licences" role="table">
                  {% if sample_scan %}<caption data-sample>{{ strings.found.sample }}</caption>{% endif %}
                  <thead role="rowgroup">
                    <tr role="row">
                      {{ column(strings.licences.product) }}
                      {{ column(strings.licences.purchased) }}
                      {{ column(strings.licences.assigned) }}
                      {{ column(strings.licences.plans) }}
                    </tr>
                  </thead>
                  <tbody role="rowgroup">
                    {% for product in licences %}
                      {% set matches = product.plans %}
                      <tr data-product="{{ product.id }}" data-provenance="measured" role="row">
                        <th scope="row" role="rowheader" data-label="{{ strings.licences.product }}">{{ product.label }} <small class="prov">{{ licence_provenance }}</small>{% if product.sku_guid %}<small><code>{{ product.sku_guid }}</code></small>{% endif %}</th>
                        <td role="cell" data-label="{{ strings.licences.purchased }}">{{ format.integer(product.purchased) }}</td>
                        <td role="cell" data-label="{{ strings.licences.assigned }}">{{ format.integer(product.assigned) }}{% if product.assigned > product.purchased %}
                          <small data-reason="assigned_exceeds_purchased">{{ strings.licences.assigned_exceeds_purchased.format(count=format.integer(product.assigned - product.purchased)) }}</small>
                        {% endif %}</td>
                        <td role="cell" data-label="{{ strings.licences.plans }}">
                          {% set classified = matches|reject('none')|list %}
                          {% for workload, entries in classified|rejectattr('workload', 'none')|groupby('workload') %}
                            {% for signal, plans in entries|groupby('signal') %}
                              <div class="licence-plan">
                                {{ workload_labels[workload] }} · {{ strings.licences[signal] }}
                                <small>{% for plan in plans %}<code>{{ plan.name }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</small>
                              </div>
                            {% endfor %}
                          {% endfor %}
                          {% set no_workload = classified|selectattr('signal', 'eq', 'no_workload')|list|length %}
                          {% if no_workload %}
                            <div>{{ strings.licences.no_workload.format(count=format.integer(no_workload)) }}</div>
                          {% endif %}
                          {% set unclassified = matches|select('none')|list|length %}
                          {% if unclassified %}
                            {{ strings.licences.unclassified.format(count=format.integer(unclassified)) }}
                            {% set reason, fix = reason_text('licence_not_classified') %}
                            <small data-reason="licence_not_classified">{{ reason }} {{ fix }}</small>
                          {% elif not matches and product.assigned %}
                            {{ reason_detail('licence_plan_list_missing') }}
                          {% elif not matches %}
                            {{ strings.common.unavailable }}
                          {% endif %}
                        </td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            {% endif %}
          {% else %}
            <p data-provenance="unknown">
              <span class="prov">{{ strings.provenance.unknown }}</span>
              <small>{{ reason_detail('not_in_scan') }}</small>
            </p>
          {% endif %}
          {% for workload in inventory_workloads if catalogue_evidence[workload] %}
            <details class="workload-evidence" data-evidence-workload="{{ workload }}">
              <summary id="evidence-{{ workload }}">{{ icon('chevron-right') }}{{ workload_labels[workload] }}</summary>
              {{ finding_table(workload, catalogue_evidence[workload]) }}
            </details>
          {% endfor %}
        </div>
      </div>
    </section>
    <section data-section="appendix">
      <div class="sec grid">
        <h2 class="sec-label">{{ strings.appendix.title }}</h2>
        <div class="sec-body">
          <h3>{{ strings.appendix.collectors }}</h3>
          {% if sample_scan %}<p>{{ strings.appendix.sample_permissions }}</p>{% endif %}
          <div class="table-scroll" role="region" aria-label="{{ strings.appendix.collectors }}" tabindex="0">
            <table class="collectors" role="table">
              <thead role="rowgroup">
                <tr role="row">
                  {{ column(strings.found.collector) }}
                  {{ column(strings.appendix.status) }}
                  {{ column(strings.appendix.reason) }}
                  {{ column(strings.appendix.permissions) }}
                </tr>
              </thead>
              <tbody role="rowgroup">
                {% for collector in scan.collectors %}
                  <tr data-collector="{{ collector.id }}" role="row">
                    <th scope="row" role="rowheader" data-label="{{ strings.found.collector }}">{{ code_label('collector', collector.id) }}</th>
                    <td role="cell" data-label="{{ strings.appendix.status }}">{{ code_label('collector_status', collector.status) }}</td>
                    <td role="cell" data-label="{{ strings.appendix.reason }}">
                      {% if collector.reason %}
                        {% set reason, fix = reason_text(collector.reason) %}
                        <span data-reason="{{ collector.reason }}">{{ reason }}</span> {{ fix }}
                      {% else %}{{ strings.common.unavailable }}{% endif %}
                    </td>
                    <td role="cell" data-label="{{ strings.appendix.permissions }}">{{ collector.permissions_used|join(', ') or strings.common.unavailable }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% if scan.dropped_count %}
            <p data-ignored-count="{{ scan.dropped_count }}">{{ strings.appendix.ignored.format(count=format.integer(scan.dropped_count)) }}</p>
          {% endif %}
          <h3>{{ strings.appendix.rules }}</h3>
          <p>{{ strings.appendix.rule_file }} · <code>{{ status_rules.file_name }}</code></p>
          <dl class="rule-details">
            {% for row in statuses %}
              <dt>{{ workload_labels[row.workload] }}</dt>
              <dd>
                {% set block = status_rules.workloads[row.workload] %}
                {{ strings.appendix.ready_evidence }}
                {{ conditions_list(block.ready) }}
                {% set fired = ([row.deciding] if row.deciding else []) + row.notes|list %}
                {% set workload_rules = block.rules|select('in', fired)|list %}
                {% set target_rules = fired|reject('in', block.rules)|list %}
                {% for rule in workload_rules + target_rules %}
                  <div data-rule="{{ rule.id }}">
                    <code>{{ rule.id }}</code> · {{ status_label(rule.status) }} · {{ rule.reason[lang] }}
                    {{ conditions_list(rule.when) }}
                  </div>
                {% endfor %}
              </dd>
            {% endfor %}
          </dl>
          <h3>{{ strings.appendix.mapping }}</h3>
          <p>{{ mapping.description[lang] }}</p>
          {{ mapping_review() }}
          <p>{{ strings.appendix.mapping_file }} · <code>{{ mapping.file_name }}</code></p>
          <dl class="mapping-details">
            {% for item in mapping.functions %}
              <dt>{{ item.microsoft[lang] }} <small>{{ workload_labels[item.workload] }}</small></dt>
              <dd data-mapping-details="{{ item.function }}">
                <p>{{ item.replacement[lang] }} · {{ strings.mapping_coverage[item.coverage] }}</p>
                {% if item.note %}<p>{{ item.note[lang] }}</p>{% endif %}
                <small>{{ strings.appendix.mapping_reference }} · {{ item.reference_url or strings.common.unavailable }}</small>
                <small>{{ strings.appendix.mapping_date }} · {{ mapping_date(item) }}</small>
              </dd>
            {% endfor %}
          </dl>
          {% for workload in mapping.no_function %}
            <p><strong>{{ workload_labels[workload] }}</strong> · {{ strings.moves.no_function }}</p>
          {% endfor %}
          <h3>{{ costs.formulas_title }}</h3>
          <ul>
            {% for formula in costs.formulas %}<li>{{ formula }}</li>{% endfor %}
          </ul>
          <div data-subsection="run-details">
            <h3>{{ strings.appendix.run_details }}</h3>
            <dl class="report-meta">
              <div><dt>{{ strings.appendix.schema_version }}</dt><dd>{{ scan.schema_version }}</dd></div>
              <div><dt>{{ strings.appendix.scan_origin }}</dt><dd data-source-kind="{{ scan.source_kind }}">{{ strings.source_kind[scan.source_kind] }}</dd></div>
              <div><dt>{{ strings.appendix.scan_producer }}</dt><dd data-scan-producer>{{ scan.tool.name }}</dd></div>
              <div><dt>{{ strings.appendix.producer_version }}</dt><dd data-producer-version>{{ scan.tool.version }}</dd></div>
              <div><dt>{{ strings.appendix.renderer_version }}</dt><dd data-renderer-version>{{ tool_version }}</dd></div>
            </dl>
            <dl class="run-details">
              <dt>{{ strings.appendix.scan_role }}</dt>
              <dd><time datetime="{{ scan.generated_at }}">{{ format.date(scan.generated_at) }}</time></dd>
              <dt>{{ strings.appendix.scan_periods }}</dt>
              <dd>
                {% if scan_periods %}
                  <ul>
                    {% for period in scan_periods %}
                      <li data-reporting-period="{{ period }}">{{ format.period(period) }}</li>
                    {% endfor %}
                  </ul>
                {% else %}{{ strings.appendix.no_scan_periods }}{% endif %}
              </dd>
              <dt>{{ strings.appendix.inputs_role }}</dt>
              <dd>
                {% if inputs and inputs.as_of %}<time datetime="{{ inputs.as_of }}">{{ format.date(inputs.as_of) }}</time>
                {% else %}{{ strings.common.date_not_supplied }}{% endif %}
              </dd>
            </dl>
            <p>{{ strings.appendix.checksums }}</p>
            <ul>
              {% for name, checksum in checksums.items() %}
                <li><code>{{ name }}</code> · <code data-checksum="{{ name }}">{{ checksum }}</code></li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
  <footer data-section="footer">
    <p>{{ project_name }} · {{ repository_url }}</p>
  </footer>
</body>
</html>
